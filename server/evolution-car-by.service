# Копия боевого юнита с VPS: /etc/systemd/system/evolution-car-by.service
# Лежит в репозитории, чтобы сервер можно было поднять заново по истории,
# а не по памяти. Секреты сюда не попадают — они в /opt/evolution-car-by/lead.env.
[Unit]
Description=Сайт Evolution Car (Минск): статика + приём заявок + админка
After=network.target

[Service]
Type=simple
EnvironmentFile=/opt/evolution-car-by/lead.env
ExecStart=/usr/bin/python3 /opt/evolution-car-by/site_server.py
Restart=always
RestartSec=3
WorkingDirectory=/opt/evolution-car-by
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
