---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/v1/PageShell.astro';
import Steps from '../components/v1/Steps.astro';
import Team from '../components/v1/Team.astro';
import { about } from '../content/pages';
import { breadcrumbsLd, abs } from '../lib/seo';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'О компании', href: '/about/' },
];
---

<BaseLayout
  theme="v1"
  title={about.seoTitle}
  description={about.seoDescription}
  canonical={abs('/about/')}
  jsonLd={[breadcrumbsLd(crumbs)]}
>
  <PageShell crumbs={crumbs} h1={about.h1} lead={about.heroLead}>
    <section class="section">
      <div class="container">
        <div class="who">
          <h2 class="who__title">{about.whoTitle}</h2>
          <p class="who__text">{about.whoText}</p>
        </div>

        <ul class="stats">
          {about.stats.map((stat) => (
            <li class="card stat">
              <p class="stat__value">{stat.value}</p>
              <p class="stat__label">{stat.label}</p>
            </li>
          ))}
        </ul>

        <ul class="principles">
          {about.principles.map((item) => (
            <li class="card principle">
              <span class="dot" aria-hidden="true"></span>
              <h3 class="principle__title">{item.title}</h3>
              <p class="principle__text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Steps />

    <section class="section">
      <div class="container">
        <div class="sec-head">
          <p class="kicker">[ Поддержка после покупки ]</p>
          <div>
            <h2>{about.supportTitle}</h2>
            <p class="sec-head__lead">{about.supportLead}</p>
          </div>
        </div>
        <ul class="support">
          {about.support.map((item) => (
            <li class="card support__item">
              <h3 class="support__title">{item.title}</h3>
              <p class="support__text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Team />
  </PageShell>
</BaseLayout>

<style>
  .who { display: grid; gap: 1.5rem; margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .who__title { max-width: 16ch; }
  .who__text { color: var(--c-text-2); font-size: 1rem; line-height: 1.65; max-width: 78ch; }
  @media (min-width: 1024px) {
    .who { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 3rem; align-items: start; }
  }

  .stats { display: grid; gap: var(--gap); margin-bottom: var(--gap); }
  @media (min-width: 480px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stat { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .stat__value { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); color: var(--c-accent); line-height: 1; }
  .stat__label { color: var(--c-text-3); font-size: .875rem; margin-top: .625rem; }

  .principles { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .principles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .principles { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .principle { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); align-content: start; }
  .dot { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--c-accent); margin-bottom: 1.25rem; }
  .principle__title { font-family: var(--font-body); font-weight: 400; text-transform: none; font-size: 1.0625rem; margin-bottom: .5rem; line-height: 1.25; }
  .principle__text { color: var(--c-text-3); font-size: .875rem; line-height: 1.5; }

  .sec-head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1rem + 3vw, 3rem); }
  .sec-head__lead { color: var(--c-text-3); margin-top: 1.25rem; font-size: 1rem; max-width: 56ch; }
  @media (min-width: 1024px) {
    .sec-head { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 2rem; align-items: start; }
  }

  .support { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .support { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .support { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .support__item { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); align-content: start; }
  .support__title { font-size: 1rem; margin-bottom: .625rem; line-height: 1.25; }
  .support__text { color: var(--c-text-3); font-size: .875rem; line-height: 1.5; }
</style>
