---
import '../../../styles/theme-v2.css';
import '../../../styles/islands.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/v2/Header.astro';
import Footer from '../../../components/v2/Footer.astro';
import Breadcrumbs from '../../../components/v2/Breadcrumbs.astro';
import CarCard from '../../../components/v2/CarCard.astro';
import ModalHost from '../../../components/islands/ModalHost';
import { cars, countries, powertrains, formatUsd } from '../../../content/cars';
import { breadcrumbsLd, catalogLd, abs } from '../../../lib/seo';
import { quiz, finalOffer } from '../../../content/home';

const list = cars.filter((c) => c.countries.includes('china'));
const prices = list.map((c) => c.priceUsd ?? Infinity).filter(Number.isFinite) as number[];
const minPrice = Math.min(...prices);
const inStock = list.filter((c) => c.availability === 'in-stock').length;

const byType = (['ev', 'hybrid', 'petrol'] as const).map((t) => ({
  type: t,
  label: powertrains[t],
  count: list.filter((c) => c.powertrain === t).length,
}));

const crumbs = [
  { name: 'Главная', href: '/zeekr/' },
  { name: 'Автомобили из Китая', href: '/zeekr/catalog/' },
];

const title = `Автомобили из Китая под заказ — ${list.length} моделей | Evolution Car`;
const description =
  `${list.length} моделей с китайского рынка: электромобили, гибриды и машины с ДВС. ` +
  `Цены под ключ от ${minPrice.toLocaleString('ru-RU')} $, доставка 4–7 недель, ` +
  `таможенное оформление и документы для постановки на учёт.`;
---

<BaseLayout
  theme="v2"
  title={title}
  description={description}
  canonical={abs('/zeekr/catalog/')}
  jsonLd={[breadcrumbsLd(crumbs), catalogLd(list)]}
>
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <main>
    <section class="section">
      <div class="container">
        <div class="head">
          <div>
            <p class="kicker">Каталог</p>
            <h1 class="head__title">Автомобили из Китая</h1>
          </div>
          <p class="head__lead">
            Подборка моделей, которые мы готовы привезти прямо сейчас. Цена указана
            ориентировочно под ключ — с доставкой, таможенным оформлением и документами.
          </p>
        </div>

        <dl class="facts">
          <div><dt>Моделей</dt><dd>{list.length}</dd></div>
          <div><dt>В наличии</dt><dd>{inStock}</dd></div>
          <div><dt>Цена от</dt><dd class="accent">{formatUsd(minPrice)}</dd></div>
          <div><dt>Срок поставки</dt><dd>4–7 недель</dd></div>
        </dl>

        <div class="types">
          {byType.map((t) => (
            <p class="type"><span class="type__n">{t.count}</span> {t.label.toLowerCase()}</p>
          ))}
        </div>

        <ul class="product-grid">
          {list.map((car, i) => (
            <li><CarCard car={car} eager={i < 3} /></li>
          ))}
        </ul>

        <p class="note">
          Цены ориентировочные и не являются публичной офертой. Итоговая стоимость зависит
          от комплектации, курса валют и условий конкретной поставки.
        </p>
      </div>
    </section>
  </main>

  <Footer />
  <ModalHost
    client:idle
    quizTitle={quiz.title}
    quizSteps={quiz.steps}
    contactQuestion={quiz.contactStep.q}
    channels={quiz.contactStep.channels}
    consent={finalOffer.consent}
    success={finalOffer.success}
    videoPoster="/img/unsplash/service.jpg"
  />
</BaseLayout>

<style>
  .head { display: grid; gap: 1.25rem; }
  .head__title { margin-top: .875rem; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 44ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    overflow: hidden;
  }
  @media (min-width: 768px) { .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .facts > div { background: var(--c-surface); padding: 1rem 1.25rem; }
  .facts dt { color: var(--c-text-3); font-size: .75rem; }
  .facts dd { margin: .375rem 0 0; font-size: 1.0625rem; }
  .facts .accent { color: var(--c-accent); font-family: var(--font-display); }

  .types {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-block: clamp(1.5rem, 1rem + 2vw, 2rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-text-2);
    font-size: .9375rem;
  }
  .type__n { color: var(--c-text); font-family: var(--font-display); font-size: 1.0625rem; }


  .note {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    color: var(--c-text-3);
    font-size: .75rem;
    line-height: 1.5;
    max-width: 92ch;
  }
</style>
