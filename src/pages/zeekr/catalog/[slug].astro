---
import '../../../styles/theme-v2.css';
import '../../../styles/islands.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/v2/Header.astro';
import Footer from '../../../components/v2/Footer.astro';
import Breadcrumbs from '../../../components/v2/Breadcrumbs.astro';
import CarCard from '../../../components/v2/CarCard.astro';
import ModalHost from '../../../components/islands/ModalHost';
import LeadForm from '../../../components/islands/LeadForm';
import {
  cars, countries, powertrains, availabilities, formatUsd, specGroups, slugify, modelSlug, noteRows,
} from '../../../content/cars';
import type { Car } from '../../../content/cars';
import { breadcrumbsLd, abs } from '../../../lib/seo';
import { quiz, finalOffer, benefits } from '../../../content/home';

export function getStaticPaths() {
  return cars
    .filter((c) => c.countries.includes('china'))
    .map((car) => ({
      params: { slug: `${slugify(car.brand)}-${modelSlug(car)}` },
      props: { car },
    }));
}

const { car } = Astro.props as { car: Car };
const groups = specGroups(car);
const path = `/zeekr/catalog/${slugify(car.brand)}-${modelSlug(car)}/`;

const crumbs = [
  { name: 'Главная', href: '/zeekr/' },
  { name: 'Автомобили из Китая', href: '/zeekr/catalog/' },
  { name: car.title, href: path },
];

const facts = [
  ...(car.priceUsd ? [{ label: 'Ориентир под ключ', value: `от ${formatUsd(car.priceUsd)}`, accent: true }] : []),
  ...(car.priceByn ? [{ label: 'В рублях', value: `≈ ${car.priceByn.toLocaleString('ru-RU')} BYN` }] : []),
  { label: 'Наличие', value: availabilities[car.availability] },
  { label: 'Двигатель', value: powertrains[car.powertrain] },
  ...(car.year ? [{ label: 'Год выпуска', value: car.year }] : []),
  { label: 'Срок поставки', value: '4–7 недель' },
];

const similar = cars
  .filter((c) => c.countries.includes('china') && c.slug !== car.slug && c.brand === car.brand)
  .concat(cars.filter((c) => c.countries.includes('china') && c.slug !== car.slug && c.powertrain === car.powertrain))
  .filter((c, i, arr) => arr.findIndex((x) => x.slug === c.slug) === i)
  .slice(0, 3);

const title = `${car.title}${car.year ? ` ${car.year}` : ''} из Китая под ключ${car.priceUsd ? ` – от ${car.priceUsd.toLocaleString('ru-RU')} $` : ''} | Evolution Car`;
const description =
  `${car.title} из Китая: ${powertrains[car.powertrain].toLowerCase()}, ` +
  `${availabilities[car.availability].toLowerCase()}. ${car.description} ` +
  `Доставка, таможенное оформление и документы для постановки на учёт – на нас.`;
---

<BaseLayout
  theme="v2"
  title={title}
  description={description}
  canonical={abs(path)}
  ogImage={car.photo}
  jsonLd={[breadcrumbsLd(crumbs)]}
>
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <main>
    <article>
      <section class="section">
        <div class="container top">
          <figure class="shot">
            <img
              src={car.photo}
              alt={`${car.title} – ${powertrains[car.powertrain].toLowerCase()}, поставка из Китая`}
              width="900"
              height="563"
              fetchpriority="high"
            />
            <figcaption>Фотография модели. Снимки конкретного автомобиля менеджер пришлёт до договора.</figcaption>
          </figure>

          <div class="intro">
            <p class="kicker">{countries[car.country].label} · {availabilities[car.availability]}</p>
            <h1 class="intro__title">{car.title}</h1>
            <p class="intro__text">{car.description}</p>

            <dl class="facts">
              {facts.map((f) => (
                <div class={f.accent ? 'fact fact--accent' : 'fact'}>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>

            <div class="actions">
              <a class="btn" href="#request">Запросить расчёт</a>
              <button class="btn btn--ghost" type="button" data-open="quiz">Пройти опрос</button>
            </div>

            {car.note && (
              <dl class="disclaimer-inline">
                {noteRows(car.note).map((row) => (
                  <div>
                    {row.label && <dt>{row.label}</dt>}
                    <dd>
                      {row.value.startsWith('http')
                        ? <a href={row.value} target="_blank" rel="nofollow noopener">av.by</a>
                        : row.value}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
      </section>

      {groups.length > 0 && (
        <section class="section section--tight">
          <div class="container">
            <h2 class="title">Характеристики</h2>
            <div class="specs">
              {groups.map((g) => (
                <div class="specs__col">
                  <h3 class="specs__h">{g.group}</h3>
                  <dl>
                    {g.rows.map((row) => (
                      <div class="row">
                        <dt>{row.label}</dt>
                        <dd>
                          {row.value.startsWith('http')
                            ? <a href={row.value} target="_blank" rel="nofollow noopener">Открыть источник</a>
                            : row.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="section section--tight">
        <div class="container">
          <h2 class="title">Что входит в стоимость под ключ</h2>
          <ul class="incl">
            {benefits.map((b) => (
              <li>
                <h3 class="incl__h">{b.title}</h3>
                <p class="incl__t">{b.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="request">
        <div class="container request">
          <div>
            <h2 class="title title--plain">Запросить расчёт по {car.title}</h2>
            <p class="request__text">
              Менеджер уточнит комплектацию и год, проверит доступные лоты на площадках Китая
              и пришлёт стоимость под ключ с учётом доставки и таможенного оформления.
            </p>
          </div>
          <div class="panel">
            <LeadForm
              client:visible
              namePlaceholder={finalOffer.namePlaceholder}
              phonePlaceholder={finalOffer.phonePlaceholder}
              cta={finalOffer.cta}
              consent={finalOffer.consent}
              success={finalOffer.success}
              source={`Zeekr-версия, карточка: ${car.title}`}
            />
          </div>
        </div>
      </section>

      {similar.length > 0 && (
        <section class="section section--tight">
          <div class="container">
            <h2 class="title">Похожие модели</h2>
            <ul class="product-grid">
              {similar.map((item) => <li><CarCard car={item} /></li>)}
            </ul>
          </div>
        </section>
      )}

      <div class="container">
        <p class="note">
          Цена ориентировочная и не является публичной офертой. Итоговая стоимость зависит
          от комплектации, состояния, курса валют и условий конкретной поставки.
        </p>
      </div>
    </article>
  </main>

  <Footer />
  <ModalHost
    client:idle
    quizTitle={quiz.title}
    quizSteps={quiz.steps}
    contactQuestion={quiz.contactStep.q}
    channels={quiz.contactStep.channels}
    consent={finalOffer.consent}
    success={finalOffer.success}
    videoPoster="/img/unsplash/service.jpg"
  />
</BaseLayout>

<style>
  .section--tight { padding-block: clamp(2rem, 1.4rem + 2.4vw, 3rem); }
  .title {
    font-size: clamp(1.25rem, 1.1rem + .8vw, 1.625rem);
    padding-bottom: .875rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--c-line);
  }
  .title--plain { border-bottom: 0; padding-bottom: 0; margin-bottom: 1rem; }

  .top { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  @media (min-width: 1024px) { .top { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; } }
  .shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--r-card); background: var(--c-surface); }
  .shot figcaption { color: var(--c-text-3); font-size: .75rem; margin-top: .75rem; line-height: 1.5; }

  .intro__title { margin-top: .75rem; }
  .intro__text { color: var(--c-text-2); margin-top: 1rem; line-height: 1.6; }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.75rem;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .fact { background: var(--c-surface); padding: .875rem 1rem; }
  .fact dt { color: var(--c-text-3); font-size: .75rem; }
  .fact dd { margin: .25rem 0 0; font-size: .9375rem; }
  .fact--accent dd { font-family: var(--font-display); font-size: 1.25rem; color: var(--c-accent); }

  .actions { display: flex; flex-wrap: wrap; gap: .625rem; margin-top: 1.5rem; }
  .disclaimer-inline > div { display: flex; gap: .5rem; flex-wrap: wrap; padding-block: .25rem; }
  .disclaimer-inline dt { color: var(--c-text-3); }
  .disclaimer-inline dt::after { content: ':'; }
  .disclaimer-inline dd { margin: 0; }
  .disclaimer-inline dd a { color: var(--c-accent); }
  .disclaimer-inline {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-text-3);
    font-size: .8125rem;
    line-height: 1.5;
  }

  .specs { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  @media (min-width: 768px) { .specs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .specs__h { font-size: .9375rem; color: var(--c-text-3); margin-bottom: .75rem; }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: .625rem;
    border-bottom: 1px solid var(--c-line);
    font-size: .875rem;
  }
  .row dt { color: var(--c-text-3); flex: none; max-width: 48%; }
  .row dd { margin: 0; text-align: right; }
  .row dd a { color: var(--c-accent); }

  .incl { display: grid; gap: clamp(1.25rem, 1rem + 1.5vw, 2rem); }
  @media (min-width: 640px) { .incl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .incl { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .incl__h { font-size: 1rem; margin-bottom: .5rem; }
  .incl__t { color: var(--c-text-2); font-size: .875rem; line-height: 1.5; }

  .request { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 1024px) { .request { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: 3.5rem; } }
  .request__text { color: var(--c-text-2); font-size: .9375rem; max-width: 56ch; }
  .panel {
    background: color-mix(in srgb, #3a241c 82%, var(--c-surface));
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 1rem + 2vw, 2rem);
  }


  .note {
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
    color: var(--c-text-3);
    font-size: .75rem;
    line-height: 1.5;
    max-width: 92ch;
  }
</style>
