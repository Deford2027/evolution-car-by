---
import '../../styles/theme-v2.css';
import '../../styles/islands.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/v2/Header.astro';
import Hero from '../../components/v2/Hero.astro';
import Directions from '../../components/v2/Directions.astro';
import Stats from '../../components/v2/Stats.astro';
import Showroom from '../../components/v2/Showroom.astro';
import WhyOrder from '../../components/v2/WhyOrder.astro';
import Cost from '../../components/v2/Cost.astro';
import Aftercare from '../../components/v2/Aftercare.astro';
import Steps from '../../components/v2/Steps.astro';
import Reviews from '../../components/v2/Reviews.astro';
import Team from '../../components/v2/Team.astro';
import Faq from '../../components/v2/Faq.astro';
import FinalOffer from '../../components/v2/FinalOffer.astro';
import Contacts from '../../components/v2/Contacts.astro';
import Footer from '../../components/v2/Footer.astro';
---

<BaseLayout
  theme="v2"
  title="Evolution Car — автомобили из Китая, Кореи, США и Европы под ключ"
  description="Подбираем и привозим автомобили из Китая, Южной Кореи, США и Европы. Экономия до 30%, работа по договору, доставка под ключ и собственный сервис."
>
  <Header />
  <main>
    <Hero />
    <Directions />
    <Stats />
    <Showroom />
    <WhyOrder />
    <Cost />
    <Aftercare />
    <Steps />
    <Reviews />
    <Team />
    <Faq />
    <FinalOffer />
    <Contacts />
  </main>
  <Footer />
</BaseLayout>
