    note: 'Наличие, комплектацию и параметры выбранной версии уточняем перед предложением.',
  },
  steps: {
    title: 'Перед покупкой проверим экономику парка',
    items: [
      { num: '01', title: 'Пробег и зарядка', text: 'Учтём дневной пробег, доступ к зарядке и время простоя автомобиля.' },
      { num: '02', title: 'Нужная версия', text: 'Сверим оснащение и параметры конкретного автомобиля до заказа.' },
      { num: '03', title: 'Полный расчёт', text: 'Покажем итоговую стоимость с доставкой и оформлением и сравним расходы на эксплуатацию.' },
