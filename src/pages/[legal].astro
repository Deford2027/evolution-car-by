---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/v1/PageShell.astro';
import { legalPages } from '../content/pages';
import type { LegalPage } from '../content/pages';
import { breadcrumbsLd, abs } from '../lib/seo';

export function getStaticPaths() {
  return legalPages.map((page) => ({ params: { legal: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: LegalPage };

// Разбор текста документа: «N. Заголовок» – раздел, строки с тире подряд –
// список, остальное – абзацы.
type Block = { kind: 'h' | 'p'; text: string } | { kind: 'ul'; items: string[] };
const blocks: Block[] = [];
for (const line of (page.text ?? '').split('\n').map((l) => l.trim()).filter(Boolean)) {
  const item = line.match(/^[—-]\s+(.*)$/);
  const last = blocks[blocks.length - 1];
  if (item) {
    if (last?.kind === 'ul') last.items.push(item[1]);
    else blocks.push({ kind: 'ul', items: [item[1]] });
  } else {
    blocks.push({ kind: /^\d+\.\s/.test(line) ? 'h' : 'p', text: line });
  }
}

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: page.h1, href: `/${page.slug}/` },
];
---

<BaseLayout
  theme="v1"
  title={page.seoTitle}
  description={page.intro}
  canonical={abs(`/${page.slug}/`)}
  jsonLd={[breadcrumbsLd(crumbs)]}
>
  <PageShell crumbs={crumbs} h1={page.h1} lead={page.intro} contacts={false}>
    <section class="section" style="padding-top:0">
      <div class="container">
        {page.text ? (
          <div class="doc doc--full">
            {blocks.map((block) =>
              block.kind === 'h' ? <h2 class="doc__title">{block.text}</h2>
              : block.kind === 'ul' ? <ul class="doc__list">{block.items.map((item) => <li>{item}</li>)}</ul>
              : <p class="doc__text">{block.text}</p>
            )}
          </div>
        ) : (
          <>
            <div class="doc">
              {page.sections?.map((item, i) => (
                <section class="doc__part">
                  <h2 class="doc__title">{i + 1}. {item.title}</h2>
                  <p class="doc__text">{item.text}</p>
                </section>
              ))}
            </div>

            <p class="doc__note">
              Это рабочий каркас документа. Окончательную редакцию с реквизитами и формулировками
              под законодательство Республики Беларусь предоставляет владелец сайта.
            </p>
          </>
        )}
      </div>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .doc { display: grid; gap: 2rem; max-width: 80ch; }
  .doc__title {
    font-family: var(--font-body);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    font-size: 1.125rem;
    margin-bottom: .75rem;
  }
  .doc__text { color: var(--c-text-2); line-height: 1.65; }
  .doc--full { gap: 1rem; }
  .doc--full .doc__title { margin: 1.5rem 0 0; }
  .doc--full .doc__title:first-child { margin-top: 0; }
  .doc__list { display: grid; gap: .5rem; padding-left: 1.25rem; color: var(--c-text-2); line-height: 1.65; list-style: '— '; }
  .doc__note {
    margin-top: clamp(2rem, 1.2rem + 3vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-text-3);
    font-size: .8125rem;
    max-width: 80ch;
  }
</style>
