---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/v1/Header.astro';
import Footer from '../components/v1/Footer.astro';
import Breadcrumbs from '../components/v1/Breadcrumbs.astro';
import ModalHost from '../components/islands/ModalHost';
import LeadForm from '../components/islands/LeadForm';
import { deliveryLanding as t } from '../content/landing';
import { breadcrumbsLd, abs } from '../lib/seo';
import { quiz, finalOffer } from '../content/home';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Доставка и растаможка', href: '/dostavka-i-rastamozhka/' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.stepsTitle,
  description: t.answer,
  step: t.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.t,
    text: s.d,
  })),
};
---

<BaseLayout
  theme="v1"
  title={t.seoTitle}
  description={t.seoDescription}
  canonical={abs('/dostavka-i-rastamozhka/')}
  jsonLd={[breadcrumbsLd(crumbs), faqLd, howToLd]}
>
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <main>
    <section class="section section--top">
      <div class="container">
        <div class="head">
          <div>
            <p class="kicker">[ Доставка ]</p>
            <h1>{t.h1}</h1>
            <p class="head__lead">{t.lead}</p>
            <div class="head__actions">
              <a class="btn" href="#request">Рассчитать доставку</a>
              <a class="btn btn--ghost" href="/catalog/">Смотреть каталог</a>
            </div>
          </div>

          <div class="card answer">
            <p class="answer__label">Коротко</p>
            <p class="answer__text">{t.answer}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">{t.stepsTitle}</h2>
        <ol class="steps">
          {t.steps.map((s) => (
            <li class="card step">
              <div class="step__top">
                <span class="step__n">{s.n}</span>
                <span class="step__when">{s.when}</span>
              </div>
              <h3 class="step__t">{s.t}</h3>
              <p class="step__d">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">{t.routesTitle}</h2>
        <div class="tw">
          <table class="routes">
            <thead>
              <tr><th>Направление</th><th>Срок под ключ</th><th>Как везём</th><th>Особенность</th></tr>
            </thead>
            <tbody>
              {t.routes.map((r) => (
                <tr>
                  <td class="routes__from">{r.from}</td>
                  <td class="routes__weeks">{r.weeks}</td>
                  <td>{r.how}</td>
                  <td class="routes__note">{r.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">{t.includedTitle}</h2>
        <div class="split">
          <div class="card split__col">
            <h3 class="split__title">Входит в цену</h3>
            <ul class="list list--in">
              {t.included.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="card split__col">
            <h3 class="split__title">Оплачивается отдельно</h3>
            <ul class="list list--out">
              {t.notIncluded.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Частые вопросы о доставке</h2>
        <div class="faq">
          {t.faq.map((item, i) => (
            <details class="faq__item" name="delivery-faq" open={i === 0}>
              <summary class="faq__q">
                <span>{item.q}</span>
                <span class="faq__mark" aria-hidden="true">↗</span>
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="request">
      <div class="container">
        <div class="card request">
          <div>
            <h2 class="request__title">Рассчитать доставку под ваш автомобиль</h2>
            <p class="request__text">
              Назовите модель и страну, откуда хотите привезти, — пришлём расчёт
              со сроком, составом платежей и итоговой суммой под ключ.
            </p>
          </div>
          <LeadForm
            client:visible
            namePlaceholder={finalOffer.namePlaceholder}
            phonePlaceholder={finalOffer.phonePlaceholder}
            cta={finalOffer.cta}
            consent={finalOffer.consent}
            success={finalOffer.success}
            source="Посадочная: доставка и растаможка"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <ModalHost
    client:idle
    quizTitle={quiz.title}
    quizSteps={quiz.steps}
    contactQuestion={quiz.contactStep.q}
    channels={quiz.contactStep.channels}
    consent={finalOffer.consent}
    success={finalOffer.success}
    videoPoster="/img/unsplash/service.jpg"
  />
</BaseLayout>

<style>
  .section--top { padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .section--tight { padding-block: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .block__title { margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem); }

  .head { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  @media (min-width: 1024px) { .head { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; } }
  .head h1 { margin-top: .875rem; }
  .head__lead { color: var(--c-text-2); margin-top: 1.25rem; font-size: 1.0625rem; max-width: 54ch; }
  .head__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }

  .answer { padding: clamp(1.5rem, 1rem + 2vw, 2rem); background: var(--c-bg-alt); display: grid; gap: 1rem; }
  .answer__label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--c-accent); }
  .answer__text { color: var(--c-text-2); line-height: 1.6; }

  .steps { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .step { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); display: grid; gap: .625rem; align-content: start; }
  .step__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .step__n { font-size: 1.125rem; }
  .step__when {
    font-size: .75rem;
    color: var(--c-accent);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    padding: .1875rem .625rem;
    white-space: nowrap;
  }
  .step__t { font-family: var(--font-body); font-weight: 400; text-transform: none; font-size: 1.125rem; line-height: 1.25; }
  .step__d { color: var(--c-text-3); font-size: .875rem; line-height: 1.5; }

  .tw { overflow-x: auto; border: 1px solid var(--c-line); border-radius: var(--r-card); background: var(--c-surface); }
  .routes { border-collapse: collapse; width: 100%; min-width: 620px; font-size: .9375rem; }
  .routes th, .routes td { text-align: left; padding: .875rem 1.25rem; border-bottom: 1px solid var(--c-line); }
  .routes th { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--c-text-3); font-weight: 400; }
  .routes tbody tr:last-child td { border-bottom: 0; }
  .routes__from { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; }
  .routes__weeks { color: var(--c-accent); white-space: nowrap; }
  .routes__note { color: var(--c-text-3); font-size: .875rem; }

  .split { display: grid; gap: var(--gap); }
  @media (min-width: 900px) { .split { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .split__col { padding: clamp(1.5rem, 1rem + 1.5vw, 2rem); align-content: start; }
  .split__title { font-size: 1.125rem; margin-bottom: 1.25rem; }
  .list { display: grid; gap: .75rem; }
  .list li { position: relative; padding-left: 1.75rem; color: var(--c-text-2); font-size: .9375rem; line-height: 1.5; }
  .list li::before {
    position: absolute;
    left: 0; top: 0;
    font-size: .9375rem;
  }
  .list--in li::before { content: '✓'; color: var(--c-accent); }
  .list--out li::before { content: '—'; color: var(--c-text-3); }

  .faq { display: grid; gap: var(--gap); }
  .faq__item { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--r-card); padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .faq__q {
    display: flex; align-items: start; justify-content: space-between; gap: 1.5rem;
    cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    font-size: clamp(1rem, .95rem + .4vw, 1.1875rem); line-height: 1.25;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__mark {
    flex: none; width: 2.5rem; height: 2.5rem;
    display: grid; place-items: center;
    border: 1px solid var(--c-line-strong); border-radius: 8px;
    color: var(--c-text-2);
    transition: background .25s var(--ease), color .25s var(--ease), rotate .25s var(--ease);
  }
  .faq__item[open] .faq__mark { background: var(--c-accent); border-color: var(--c-accent); color: #fff; rotate: 90deg; }
  .faq__a { color: var(--c-text-3); margin-top: 1.25rem; line-height: 1.6; max-width: 80ch; }

  .request {
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    background: var(--c-bg-alt);
    display: grid; gap: 2rem; align-items: center;
  }
  @media (min-width: 1024px) { .request { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: 3.5rem; } }
  .request__title { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem); }
  .request__text { color: var(--c-text-3); font-size: .9375rem; margin-top: 1rem; max-width: 56ch; }
</style>
