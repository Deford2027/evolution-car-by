---
import '../../styles/theme-v2.css';
import '../../styles/islands.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/v2/Header.astro';
import Footer from '../../components/v2/Footer.astro';
import Breadcrumbs from '../../components/v2/Breadcrumbs.astro';
import CarCard from '../../components/v2/CarCard.astro';
import CatalogFilter from '../../components/islands/CatalogFilter';
import { cars, countries, powertrains, conditions } from '../../content/cars';
import { breadcrumbsLd, catalogLd, abs } from '../../lib/seo';
import { quiz, finalOffer } from '../../content/home';
import ModalHost from '../../components/islands/ModalHost';

const crumbs = [
  { name: 'Главная', href: '/zeekr/' },
  { name: 'Каталог автомобилей', href: '/catalog/' },
];

const inStock = cars.filter((c) => c.availability === 'in-stock').length;
const minPrice = Math.min(...cars.map((c) => c.priceUsd));

const title = `Каталог автомобилей под заказ из Китая, Кореи, США и Европы | Evolution Car`;
const description =
  `${cars.length} автомобилей в подборке: ${inStock} в наличии, цены от ${minPrice.toLocaleString('ru-RU')} $ ` +
  `под ключ. Электромобили, гибриды и машины с ДВС с доставкой в Минск, ` +
  `таможенным оформлением и документами для постановки на учёт.`;

const facets = {
  country: Object.entries(countries).map(([value, meta]) => ({ value, label: meta.label })),
  powertrain: Object.entries(powertrains).map(([value, label]) => ({ value, label })),
  condition: Object.entries(conditions).map(([value, label]) => ({ value, label })),
};
---

<BaseLayout
  theme="v2"
  title={title}
  description={description}
  canonical={abs('/catalog/')}
  jsonLd={[breadcrumbsLd(crumbs), catalogLd(cars)]}
>
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <main>
    <section class="section">
      <div class="container">
        <div class="head">
          <div>
            <p class="kicker">Каталог</p>
            <h1 class="head__title">Автомобили под заказ и в наличии</h1>
          </div>
          <p class="head__lead">
            Подборка обновляется вручную: это машины, которые мы готовы привезти прямо сейчас.
            Нужной модели нет — оставьте заявку, проверим предложения на зарубежных площадках.
          </p>
        </div>

        <CatalogFilter
          client:load
          facets={facets}
          total={cars.length}
          cars={cars.map((c) => ({
            slug: c.slug,
            country: c.country,
            powertrain: c.powertrain,
            condition: c.condition,
            price: c.priceUsd,
          }))}
        />

        <ul class="grid-cars" id="catalog-grid">
          {cars.map((car, i) => (
            <li data-slug={car.slug}>
              <CarCard car={car} eager={i < 3} />
            </li>
          ))}
        </ul>

        <p class="note">
          Цены указаны ориентировочно под ключ и не являются публичной офертой.
          Итоговая стоимость зависит от курса, комплектации и условий конкретной поставки.
        </p>
      </div>
    </section>
  </main>

  <Footer />
  <ModalHost
    client:idle
    quizTitle={quiz.title}
    quizSteps={quiz.steps}
    contactQuestion={quiz.contactStep.q}
    channels={quiz.contactStep.channels}
    consent={finalOffer.consent}
    success={finalOffer.success}
    videoPoster="/img/unsplash/service.jpg"
  />
</BaseLayout>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.25rem); }
  .head__title { margin-top: .875rem; max-width: 18ch; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 46ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  .grid-cars { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .grid-cars { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grid-cars { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid-cars li { display: grid; }

  .note {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    color: var(--c-text-3);
    font-size: .75rem;
    line-height: 1.5;
    max-width: 92ch;
  }
</style>
