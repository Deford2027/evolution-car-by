---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/v1/PageShell.astro';
import CarCard from '../components/v1/CarCard.astro';
import { portfolio } from '../content/pages';
import { cars } from '../content/cars';
import { breadcrumbsLd, abs } from '../lib/seo';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Пригнали', href: '/portfolio/' },
];

// пока фотоотчётов нет, показываем позиции, которые уже в наличии
const delivered = cars.filter((c) => c.availability === 'in-stock');
---

<BaseLayout
  theme="v1"
  title={portfolio.seoTitle}
  description={portfolio.seoDescription}
  canonical={abs('/portfolio/')}
  jsonLd={[breadcrumbsLd(crumbs)]}
>
  <PageShell crumbs={crumbs} h1={portfolio.h1} lead={portfolio.lead}>
    <section class="section" style="padding-top:0">
      <div class="container">
        {delivered.length > 0 && (
          <ul class="product-grid">
            {delivered.map((car) => <li><CarCard car={car} /></li>)}
          </ul>
        )}

        <div class="card note">
          <div>
            <h2 class="note__title">Фотоотчёты пополняются</h2>
            <p class="note__text">
              Снимки с выдачи машин добавляем по мере поставок. Хотите посмотреть
              автомобили, которые можно привезти прямо сейчас – загляните в каталог.
            </p>
          </div>
          <a class="btn note__cta" href="/catalog/">Смотреть каталог</a>
        </div>
      </div>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .product-grid { margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }

  .note {
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    background: var(--c-bg-alt);
    display: grid;
    gap: 1.5rem;
  }
  .note__title { font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem); }
  .note__text { color: var(--c-text-3); margin-top: 1rem; max-width: 64ch; }
  .note__cta { justify-self: start; }
  @media (min-width: 1024px) {
    .note { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3rem; }
    .note__cta { justify-self: end; }
  }
</style>
