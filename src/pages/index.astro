---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/v1/Header.astro';
import Hero from '../components/v1/Hero.astro';
import Benefits from '../components/v1/Benefits.astro';
import Directions from '../components/v1/Directions.astro';
import Showroom from '../components/v1/Showroom.astro';
import WhyOrder from '../components/v1/WhyOrder.astro';
import Cost from '../components/v1/Cost.astro';
import Aftercare from '../components/v1/Aftercare.astro';
import Steps from '../components/v1/Steps.astro';
import Reviews from '../components/v1/Reviews.astro';
import Team from '../components/v1/Team.astro';
import Faq from '../components/v1/Faq.astro';
import FinalOffer from '../components/v1/FinalOffer.astro';
---

<BaseLayout
  theme="v1"
  title="Evolution Car — автомобили из Китая, Кореи, США и Европы под ключ"
  description="Подбираем и привозим автомобили из Китая, Южной Кореи, США и Европы. Экономия до 30%, работа по договору, доставка под ключ и собственный сервис."
>
  <Header />
  <main>
    <Hero />
    <Benefits />
    <Directions />
    <Showroom />
    <WhyOrder />
    <Cost />
    <Aftercare />
    <Steps />
    <Reviews />
    <Team />
    <Faq />
    <FinalOffer />
  </main>
</BaseLayout>
