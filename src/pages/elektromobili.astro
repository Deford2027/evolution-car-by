---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/v1/Header.astro';
import Footer from '../components/v1/Footer.astro';
import Breadcrumbs from '../components/v1/Breadcrumbs.astro';
import CarCard from '../components/v1/CarCard.astro';
import ModalHost from '../components/islands/ModalHost';
import LeadForm from '../components/islands/LeadForm';
import { cars, formatUsd } from '../content/cars';
import { allBrands } from '../content/brands';
import { evLanding as t } from '../content/landing';
import { breadcrumbsLd, abs } from '../lib/seo';
import { quiz, finalOffer } from '../content/home';

const evs = cars.filter((c) => c.powertrain === 'ev');
const prices = evs.map((c) => c.priceUsd ?? Infinity).filter(Number.isFinite) as number[];
const minPrice = Math.min(...prices);
const inStock = evs.filter((c) => c.availability === 'in-stock').length;
const evBrands = allBrands().filter((b) => b.cars.some((c) => c.powertrain === 'ev'));

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Электромобили', href: '/elektromobili/' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  theme="v1"
  title={t.seoTitle}
  description={t.seoDescription}
  canonical={abs('/elektromobili/')}
  jsonLd={[breadcrumbsLd(crumbs), faqLd]}
>
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <main>
    <section class="section section--top">
      <div class="container">
        <div class="head">
          <div>
            <p class="kicker">[ Электромобили ]</p>
            <h1>{t.h1}</h1>
            <p class="head__lead">{t.lead}</p>
            <div class="head__actions">
              <a class="btn" href="#catalog">Смотреть {evs.length} моделей</a>
              <button class="btn btn--ghost" type="button" data-open="quiz">Рассчитать стоимость</button>
            </div>
          </div>

          <div class="card answer">
            <p class="answer__label">Коротко</p>
            <p class="answer__text">{t.answer}</p>
            <dl class="answer__facts">
              <div><dt>Моделей в каталоге</dt><dd>{evs.length}</dd></div>
              <div><dt>В наличии</dt><dd>{inStock}</dd></div>
              <div><dt>Цена от</dt><dd class="accent">{formatUsd(minPrice)}</dd></div>
              <div><dt>Срок поставки</dt><dd>4–10 недель</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">{t.whyTitle}</h2>
        <ul class="why">
          {t.why.map((item) => (
            <li class="card why__item">
              <span class="dot" aria-hidden="true"></span>
              <h3 class="why__title">{item.title}</h3>
              <p class="why__text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section--tight" id="catalog">
      <div class="container">
        <h2 class="block__title">Электромобили в наличии и под заказ</h2>
        <ul class="cards">
          {evs.slice(0, 12).map((car, i) => (
            <li><CarCard car={car} eager={i < 3} /></li>
          ))}
        </ul>
        <a class="btn btn--ghost more" href="/catalog/electro_car/">Весь каталог электромобилей</a>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">{t.howTitle}</h2>
        <dl class="how">
          {t.how.map((item) => (
            <div class="how__row">
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Электромобили по маркам</h2>
        <ul class="brands">
          {evBrands.map((b) => (
            <li>
              <a class="brand" href={`/brand/${b.slug}/`}>
                <span class="brand__name">{b.name}</span>
                <span class="brand__count">{b.cars.filter((c) => c.powertrain === 'ev').length}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Частые вопросы об электромобилях</h2>
        <div class="faq">
          {t.faq.map((item, i) => (
            <details class="faq__item" name="ev-faq" open={i === 0}>
              <summary class="faq__q">
                <span>{item.q}</span>
                <span class="faq__mark" aria-hidden="true">↗</span>
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="request">
      <div class="container">
        <div class="card request">
          <div>
            <h2 class="request__title">Подобрать электромобиль под ваш бюджет</h2>
            <p class="request__text">
              Расскажите, сколько километров в день ездите и есть ли где заряжать дома —
              менеджер предложит две-три модели под эти условия и пришлёт расчёт под ключ.
            </p>
          </div>
          <LeadForm
            client:visible
            namePlaceholder={finalOffer.namePlaceholder}
            phonePlaceholder={finalOffer.phonePlaceholder}
            cta={finalOffer.cta}
            consent={finalOffer.consent}
            success={finalOffer.success}
            source="Посадочная: электромобили"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <ModalHost
    client:idle
    quizTitle={quiz.title}
    quizSteps={quiz.steps}
    contactQuestion={quiz.contactStep.q}
    channels={quiz.contactStep.channels}
    consent={finalOffer.consent}
    success={finalOffer.success}
    videoPoster="/img/unsplash/service.jpg"
  />
</BaseLayout>

<style>
  .section--top { padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .section--tight { padding-block: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .block__title { margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem); }

  .head { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  @media (min-width: 1024px) { .head { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; } }
  .head h1 { margin-top: .875rem; }
  .head__lead { color: var(--c-text-2); margin-top: 1.25rem; font-size: 1.0625rem; max-width: 54ch; }
  .head__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }

  /* короткий ответ — первое, что заберёт AI-выдача */
  .answer { padding: clamp(1.5rem, 1rem + 2vw, 2rem); background: var(--c-bg-alt); display: grid; gap: 1rem; }
  .answer__label {
    font-family: var(--font-body);
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--c-accent);
  }
  .answer__text { color: var(--c-text-2); line-height: 1.6; }
  .answer__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: .5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
  }
  .answer__facts dt { color: var(--c-text-3); font-size: .75rem; }
  .answer__facts dd { margin-top: .25rem; font-size: 1.0625rem; }
  .answer__facts .accent { color: var(--c-accent); font-family: var(--font-display); font-weight: 700; }

  .why { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .why { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .why { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .why__item { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); align-content: start; }
  .dot { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--c-accent); margin-bottom: 1.25rem; }
  .why__title { font-family: var(--font-body); font-weight: 400; text-transform: none; font-size: 1.125rem; margin-bottom: .5rem; line-height: 1.25; }
  .why__text { color: var(--c-text-3); font-size: .875rem; line-height: 1.5; }

  .cards { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cards li { display: grid; }
  .more { display: flex; width: fit-content; margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) auto 0; }

  .how { display: grid; border-top: 1px solid var(--c-line); }
  .how__row { padding-block: 1.25rem; border-bottom: 1px solid var(--c-line); display: grid; gap: .5rem; }
  @media (min-width: 900px) { .how__row { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 2.5rem; } }
  .how dt { font-size: 1.0625rem; }
  .how dd { margin: 0; color: var(--c-text-3); line-height: 1.6; }

  .brands { display: grid; gap: var(--gap); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 640px) { .brands { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .brands { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .brand {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    padding: 1rem 1.125rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    transition: border-color .25s var(--ease);
  }
  .brand:hover { border-color: var(--c-accent); }
  .brand__name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: .9375rem; }
  .brand__count { color: var(--c-text-3); font-size: .75rem; font-variant-numeric: tabular-nums; }

  .faq { display: grid; gap: var(--gap); }
  .faq__item { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--r-card); padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .faq__q {
    display: flex; align-items: start; justify-content: space-between; gap: 1.5rem;
    cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    font-size: clamp(1rem, .95rem + .4vw, 1.1875rem); line-height: 1.25;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__mark {
    flex: none; width: 2.5rem; height: 2.5rem;
    display: grid; place-items: center;
    border: 1px solid var(--c-line-strong); border-radius: 8px;
    color: var(--c-text-2);
    transition: background .25s var(--ease), color .25s var(--ease), rotate .25s var(--ease);
  }
  .faq__item[open] .faq__mark { background: var(--c-accent); border-color: var(--c-accent); color: #fff; rotate: 90deg; }
  .faq__a { color: var(--c-text-3); margin-top: 1.25rem; line-height: 1.6; max-width: 80ch; }

  .request {
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    background: var(--c-bg-alt);
    display: grid; gap: 2rem; align-items: center;
  }
  @media (min-width: 1024px) { .request { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: 3.5rem; } }
  .request__title { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem); }
  .request__text { color: var(--c-text-3); font-size: .9375rem; margin-top: 1rem; max-width: 56ch; }
</style>
