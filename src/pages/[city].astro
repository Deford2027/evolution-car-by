---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/v1/Header.astro';
import Footer from '../components/v1/Footer.astro';
import Breadcrumbs from '../components/v1/Breadcrumbs.astro';
import CarCard from '../components/v1/CarCard.astro';
import ModalHost from '../components/islands/ModalHost';
import LeadForm from '../components/islands/LeadForm';
import { cities } from '../content/cities';
import type { City } from '../content/cities';
import { cars, formatUsd, sections } from '../content/cars';
import { deliveryLanding } from '../content/landing';
import { breadcrumbsLd, abs } from '../lib/seo';
import { quiz, finalOffer } from '../content/home';
import { site } from '../content/site';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: city.name, href: `/${city.slug}/` },
];

const evs = cars.filter((c) => c.powertrain === 'ev');
const prices = cars.map((c) => c.priceUsd ?? Infinity).filter(Number.isFinite) as number[];
const minPrice = Math.min(...prices);
const picks = cars.filter((c) => c.availability === 'in-stock').concat(evs).slice(0, 6);

const isMinsk = city.slug === 'minsk';

const answer = isMinsk
  ? `Автомобиль под ключ ${city.in} обходится от ${formatUsd(minPrice)}: в цену входят покупка, ` +
    `доставка, страхование на время перевозки, таможенное оформление и документы для постановки ` +
    `на учёт. Срок – 4–7 недель для Китая и Кореи, 7–10 недель для США. Выдача и сервис – ` +
    `по адресу ${site.showroom}.`
  : `Привозим автомобили ${city.in} из Китая, Кореи, США и Европы под ключ от ${formatUsd(minPrice)}. ` +
    `Срок – 4–7 недель для Китая и Кореи, 7–10 недель для США, плюс ${city.handoff} на доставку ` +
    `${city.to} после растаможки в Минске. Документы передаём на месте, регистрация – по месту жительства.`;

const faq = [
  {
    q: `Сколько стоит пригнать автомобиль ${city.in}?`,
    a:
      `Ориентир по каталогу – от ${formatUsd(minPrice)} под ключ. В сумму входят покупка автомобиля, ` +
      `страхование на время перевозки, логистика, таможенные платежи, оформление документов` +
      (isMinsk ? '' : ` и доставка ${city.to}`) +
      `. Точную цену фиксируем в договоре до начала перевозки.`,
  },
  {
    q: `Сколько ждать автомобиль ${city.in}?`,
    a: isMinsk
      ? 'Из Китая и Кореи – 4–7 недель от подтверждения заказа до выдачи, из США – 7–10 недель. Забрать машину можно в день растаможки в шоуруме на проспекте Машерова.'
      : `Из Китая и Кореи – 4–7 недель, из США – 7–10 недель, плюс ${city.handoff} на перегон ${city.to} после таможенного оформления в Минске.`,
  },
  ...(isMinsk
    ? []
    : [
        {
          q: `Нужно ли ехать в Минск, чтобы забрать автомобиль?`,
          a:
            `Нет. Автомобиль доставляем ${city.to} своим ходом или на автовозе и передаём на месте ` +
            `вместе с полным пакетом документов. Приехать в Минск можно по желанию – например, ` +
            `чтобы осмотреть машину сразу после растаможки.`,
        },
      ]),
  {
    q: `Где обслуживать автомобиль после покупки?`,
    a:
      `Собственный сервис Evolution Car работает в Минске: техническое обслуживание, компьютерная ` +
      `диагностика, высоковольтные системы, обновление ПО и русификация мультимедиа. ` +
      (isMinsk
        ? 'Сервис находится в 4-м переулке Монтажников, 13.'
        : `Для владельцев ${city.in} записываемся заранее, чтобы работы прошли за один визит.`),
  },
  {
    q: `Где заряжать электромобиль ${city.in}?`,
    a: city.chargers + ' Дома большинство владельцев ставят настенную станцию на 7 кВт: полная зарядка за ночь.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const title = `Купить автомобиль ${city.in} под заказ – цены и сроки | Evolution Car`;
const description =
  `Автомобили из Китая, Кореи, США и Европы ${city.in}: ${cars.length} позиций в каталоге, ` +
  `цены под ключ от ${minPrice.toLocaleString('ru-RU')} $` +
  (isMinsk ? ', выдача в шоуруме' : `, доставка ${city.to} за ${city.handoff} после растаможки`) +
  '. Таможенное оформление и документы для постановки на учёт.';

const others = cities.filter((c) => c.slug !== city.slug);
---

<BaseLayout
  theme="v1"
  title={title}
  description={description}
  canonical={abs(`/${city.slug}/`)}
  jsonLd={[breadcrumbsLd(crumbs), faqLd]}
>
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <main>
    <section class="section section--top">
      <div class="container">
        <div class="head">
          <div>
            <p class="kicker">[ {city.region} ]</p>
            <h1>Купить автомобиль {city.in} под заказ</h1>
            <p class="head__lead">
              Подбираем и привозим автомобили из Китая, Южной Кореи, США и Европы.
              {isMinsk
                ? ' Шоурум и сервис – в Минске, забрать машину можно в день растаможки.'
                : ` Доставляем ${city.to} и передаём на месте с полным пакетом документов.`}
            </p>
            <div class="head__actions">
              <a class="btn" href="#request">Рассчитать стоимость</a>
              <a class="btn btn--ghost" href="/catalog/">Смотреть каталог</a>
            </div>
          </div>

          <div class="card answer">
            <p class="answer__label">Коротко</p>
            <p class="answer__text">{answer}</p>
            <dl class="answer__facts">
              <div><dt>Позиций в каталоге</dt><dd>{cars.length}</dd></div>
              <div><dt>Цена под ключ</dt><dd class="accent">от {formatUsd(minPrice)}</dd></div>
              <div><dt>Срок поставки</dt><dd>4–10 недель</dd></div>
              <div>
                <dt>{isMinsk ? 'Выдача' : `Доставка ${city.to}`}</dt>
                <dd>{isMinsk ? 'в день растаможки' : city.handoff}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Как это работает для жителей {city.region.replace('ая область', 'ой области')}</h2>
        <div class="local">
          <p class="local__text">{city.local}</p>
          {city.distanceKm && (
            <dl class="local__facts">
              <div><dt>Расстояние до Минска</dt><dd>{city.distanceKm} км</dd></div>
              <div><dt>Перегон после растаможки</dt><dd>{city.handoff}</dd></div>
              <div><dt>Регистрация в ГАИ</dt><dd>по месту жительства</dd></div>
            </dl>
          )}
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Что привозим {city.in}</h2>
        <ul class="product-grid">
          {picks.map((car, i) => <li><CarCard car={car} eager={i < 3} /></li>)}
        </ul>
        <nav class="chips" aria-label="Разделы каталога">
          {sections.slice(0, 6).map((s) => (
            <a class="chip" href={`/catalog/${s.slug}/`}>{s.title}</a>
          ))}
        </nav>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Как проходит поставка</h2>
        <ol class="steps">
          {deliveryLanding.steps.map((s) => (
            <li class="card step">
              <div class="step__top">
                <span class="step__n">{s.n}</span>
                <span class="step__when">{s.when}</span>
              </div>
              <h3 class="step__t">{s.t}</h3>
              <p class="step__d">{s.d}</p>
            </li>
          ))}
        </ol>
        <p class="after">
          Подробно о маршрутах и составе платежей – на странице
          <a href="/dostavka-i-rastamozhka/">доставки и растаможки</a>.
        </p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Частые вопросы покупателей {city.in}</h2>
        <div class="faq">
          {faq.map((item, i) => (
            <details class="faq__item" name="city-faq" open={i === 0}>
              <summary class="faq__q">
                <span>{item.q}</span>
                <span class="faq__mark" aria-hidden="true">↗</span>
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="request">
      <div class="container">
        <div class="card request">
          <div>
            <h2 class="request__title">Рассчитать стоимость с доставкой {city.to}</h2>
            <p class="request__text">
              Скажите, какая модель интересует и на какой бюджет ориентируетесь – пришлём расчёт
              под ключ со сроком и составом платежей
              {isMinsk ? '.' : `, включая перегон ${city.to}.`}
            </p>
          </div>
          <LeadForm
            client:visible
            namePlaceholder={finalOffer.namePlaceholder}
            phonePlaceholder={finalOffer.phonePlaceholder}
            cta={finalOffer.cta}
            consent={finalOffer.consent}
            success={finalOffer.success}
            source={`Город: ${city.name}`}
          />
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="block__title">Доставка в другие города</h2>
        <ul class="cities">
          {others.map((c) => (
            <li>
              <a class="city" href={`/${c.slug}/`}>
                <span class="city__name">{c.name}</span>
                <span class="city__note">{c.distanceKm ? `${c.distanceKm} км` : 'шоурум'}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
  <ModalHost
    client:idle
    quizTitle={quiz.title}
    quizSteps={quiz.steps}
    contactQuestion={quiz.contactStep.q}
    channels={quiz.contactStep.channels}
    consent={finalOffer.consent}
    success={finalOffer.success}
    videoPoster="/img/unsplash/service.jpg"
  />
</BaseLayout>

<style>
  .section--top { padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .section--tight { padding-block: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .block__title { margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem); }

  .head { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  @media (min-width: 1024px) { .head { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; } }
  .head h1 { margin-top: .875rem; }
  .head__lead { color: var(--c-text-2); margin-top: 1.25rem; font-size: 1.0625rem; max-width: 54ch; }
  .head__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }

  .answer { padding: clamp(1.5rem, 1rem + 2vw, 2rem); background: var(--c-bg-alt); display: grid; gap: 1rem; }
  .answer__label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--c-accent); }
  .answer__text { color: var(--c-text-2); line-height: 1.6; }
  .answer__facts {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem;
    margin-top: .5rem; padding-top: 1.25rem; border-top: 1px solid var(--c-line);
  }
  .answer__facts dt { color: var(--c-text-3); font-size: .75rem; }
  .answer__facts dd { margin-top: .25rem; font-size: 1.0625rem; }
  .answer__facts .accent { color: var(--c-accent); font-family: var(--font-display); font-weight: 700; }

  .local { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  @media (min-width: 900px) { .local { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: start; } }
  .local__text { color: var(--c-text-2); line-height: 1.65; max-width: 74ch; }
  .local__facts { display: grid; gap: 1px; background: var(--c-line); border: 1px solid var(--c-line); border-radius: var(--r-card); overflow: hidden; }
  .local__facts > div { background: var(--c-surface); padding: .875rem 1.125rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .local__facts dt { color: var(--c-text-3); font-size: .875rem; }
  .local__facts dd { margin: 0; font-size: .9375rem; }


  .chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: clamp(1.5rem, 1rem + 2vw, 2rem); }
  .chip {
    padding: .5rem 1rem; border: 1px solid var(--c-line); border-radius: var(--r-pill);
    color: var(--c-text-2); font-size: .875rem;
  }
  .chip:hover { border-color: var(--c-accent); color: var(--c-text); }

  .steps { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .step { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); display: grid; gap: .625rem; align-content: start; }
  .step__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .step__n { font-size: 1.125rem; }
  .step__when {
    font-size: .75rem; color: var(--c-accent);
    border: 1px solid var(--c-line-strong); border-radius: var(--r-pill);
    padding: .1875rem .625rem; white-space: nowrap;
  }
  .step__t { font-family: var(--font-body); font-weight: 400; text-transform: none; font-size: 1.125rem; line-height: 1.25; }
  .step__d { color: var(--c-text-3); font-size: .875rem; line-height: 1.5; }
  .after { margin-top: 1.5rem; color: var(--c-text-3); font-size: .9375rem; }
  .after a { color: var(--c-accent); }

  .faq { display: grid; gap: var(--gap); }
  .faq__item { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--r-card); padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .faq__q {
    display: flex; align-items: start; justify-content: space-between; gap: 1.5rem;
    cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    font-size: clamp(1rem, .95rem + .4vw, 1.1875rem); line-height: 1.25;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__mark {
    flex: none; width: 2.5rem; height: 2.5rem; display: grid; place-items: center;
    border: 1px solid var(--c-line-strong); border-radius: 8px; color: var(--c-text-2);
    transition: background .25s var(--ease), color .25s var(--ease), rotate .25s var(--ease);
  }
  .faq__item[open] .faq__mark { background: var(--c-accent); border-color: var(--c-accent); color: #fff; rotate: 90deg; }
  .faq__a { color: var(--c-text-3); margin-top: 1.25rem; line-height: 1.6; max-width: 80ch; }

  .request {
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem); background: var(--c-bg-alt);
    display: grid; gap: 2rem; align-items: center;
  }
  @media (min-width: 1024px) { .request { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: 3.5rem; } }
  .request__title { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem); }
  .request__text { color: var(--c-text-3); font-size: .9375rem; margin-top: 1rem; max-width: 56ch; }

  .cities { display: grid; gap: var(--gap); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 700px) { .cities { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .city {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    padding: 1rem 1.125rem; background: var(--c-surface);
    border: 1px solid var(--c-line); border-radius: var(--r-card);
    transition: border-color .25s var(--ease);
  }
  .city:hover { border-color: var(--c-accent); }
  .city__name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: .9375rem; }
  .city__note { color: var(--c-text-3); font-size: .75rem; }
</style>
