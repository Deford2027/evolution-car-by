---
import type { Car } from '../../content/cars';
import { carTitle, formatPrice, countries, availabilities, conditions } from '../../content/cars';

interface Props { car: Car; eager?: boolean; base?: string }
const { car, eager = false, base = '/zeekr/catalog/' } = Astro.props;

const href = `${base}${car.slug}/`;
const inStock = car.availability === 'in-stock';
---

<article class="card">
  <a class="card__shot" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={car.photos[0]}
      alt=""
      width="854"
      height="534"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <span class={inStock ? 'badge badge--ok' : 'badge'}>
      <i aria-hidden="true"></i>{availabilities[car.availability]}
    </span>
  </a>

  <div class="card__body">
    <p class="card__meta">
      {countries[car.country].label} · {conditions[car.condition]} · {car.year}
    </p>
    <h3 class="card__title"><a href={href}>{carTitle(car)}</a></h3>
    <p class="card__tagline">{car.tagline}</p>

    <ul class="card__specs">
      {car.highlights.map((item) => <li>{item}</li>)}
    </ul>

    <div class="card__foot">
      <p class="card__price">от {formatPrice(car.priceUsd)}</p>
      <span class="card__link">Подробнее <span aria-hidden="true">→</span></span>
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--c-surface);
    border-radius: var(--r-card);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    transition: background .25s var(--ease);
  }
  .card:hover { background: var(--c-surface-2); }

  .card__shot { position: relative; display: block; }
  .card__shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: center 62%; }
  .badge {
    position: absolute;
    top: .75rem;
    left: .75rem;
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    padding: .3125rem .625rem;
    border-radius: var(--r-btn);
    background: color-mix(in srgb, var(--c-bg) 72%, transparent);
    backdrop-filter: blur(6px);
    font-size: .75rem;
  }
  .badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-text-3); }
  /* на светлых фото прозрачный бейдж не читался — подкладываем фон страницы */
  .badge--ok { background: color-mix(in srgb, var(--c-bg) 72%, var(--c-ok-soft)); }
  .badge--ok i { background: var(--c-ok); }

  .card__body {
    padding: 1.25rem;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: .5rem;
  }
  .card__meta { color: var(--c-text-3); font-size: .8125rem; }
  .card__title { font-size: 1.1875rem; line-height: 1.25; }
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card { position: relative; }
  .card__tagline { color: var(--c-text-2); font-size: .875rem; line-height: 1.45; }

  .card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: .375rem;
    margin-top: .375rem;
    align-content: start;
  }
  .card__specs li {
    padding: .25rem .5rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-btn);
    color: var(--c-text-2);
    font-size: .75rem;
  }

  .card__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: .875rem;
    padding-top: .875rem;
    border-top: 1px solid var(--c-line);
  }
  .card__price { font-family: var(--font-display); font-size: 1.125rem; }
  .card__link { color: var(--c-accent); font-size: .875rem; font-weight: 600; }
</style>
