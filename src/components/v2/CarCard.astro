---
import type { Car } from '../../content/cars';
import { countries, availabilities, powertrains, formatUsd, highlights, modelSlug, slugify } from '../../content/cars';

interface Props { car: Car; eager?: boolean }
const { car, eager = false } = Astro.props;

const href = `/zeekr/catalog/${slugify(car.brand)}-${modelSlug(car)}/`;
const inStock = car.availability === 'in-stock';
const specs = highlights(car);
---

<article class="card">
  <a class="card__shot" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={car.photo}
      alt=""
      width="600"
      height="375"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <span class={inStock ? 'badge badge--ok' : 'badge'}>
      <i aria-hidden="true"></i>{availabilities[car.availability]}
    </span>
  </a>

  <div class="card__body">
    <p class="card__cat">{countries[car.country].label} · {powertrains[car.powertrain]}</p>
    <h3 class="card__title"><a href={href}>{car.title}</a></h3>
    <p class="card__text">{car.description}</p>

    {specs.length > 0 && (
      <ul class="card__specs">
        {specs.map((item) => <li>{item}</li>)}
      </ul>
    )}

    <div class="card__foot">
      {car.priceUsd && <p class="card__price">от {formatUsd(car.priceUsd)}</p>}
      <span class="card__link">Подробнее <span aria-hidden="true">→</span></span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--c-surface);
    border-radius: var(--r-card);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    transition: background .25s var(--ease);
  }
  .card:hover { background: var(--c-surface-2); }

  .card__shot { position: relative; display: block; background: var(--c-bg-alt); }
  .card__shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .badge {
    position: absolute;
    top: .75rem;
    left: .75rem;
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    padding: .3125rem .625rem;
    border-radius: var(--r-btn);
    background: color-mix(in srgb, var(--c-bg) 72%, transparent);
    backdrop-filter: blur(6px);
    font-size: .75rem;
  }
  .badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-text-3); }
  .badge--ok { background: color-mix(in srgb, var(--c-bg) 72%, var(--c-ok-soft)); }
  .badge--ok i { background: var(--c-ok); }

  .card__body {
    padding: 1.25rem;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: .5rem;
  }
  .card__cat { color: var(--c-text-3); font-size: .8125rem; }
  .card__title { font-size: 1.125rem; line-height: 1.25; }
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card__text {
    color: var(--c-text-2);
    font-size: .875rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__specs { display: flex; flex-wrap: wrap; gap: .375rem; align-content: start; margin-top: .25rem; }
  .card__specs li {
    padding: .25rem .5rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-btn);
    color: var(--c-text-2);
    font-size: .75rem;
  }

  .card__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: .875rem;
    padding-top: .875rem;
    border-top: 1px solid var(--c-line);
  }
  .card__price { font-family: var(--font-display); font-size: 1.125rem; }
  .card__link { color: var(--c-accent); font-size: .875rem; font-weight: 600; }
</style>
