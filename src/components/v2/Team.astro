---
import { team } from '../../content/home';
---

<section class="section" id="team">
  <div class="container">
    <div class="head">
      <div>
        <p class="kicker">{team.kicker}</p>
        <h2 class="head__title">{team.title}</h2>
      </div>
      <p class="head__lead">{team.lead}</p>
    </div>

    <ul class="people">
      {team.items.map((member) => (
        <li class="person">
          <img src={member.img} alt={member.name} loading="lazy" width="840" height="1120" />
          <p class="person__name">{member.name}</p>
          <p class="person__role">{member.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .head__title { margin-top: .875rem; max-width: 20ch; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 42ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  .people {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 15.5rem);
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
  }
  .person { scroll-snap-align: start; }
  .person img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--r-card);
    margin-bottom: .875rem;
    filter: grayscale(.25);
    transition: filter .3s var(--ease);
  }
  .person:hover img { filter: none; }
  .person__name { font-size: 1rem; }
  .person__role { color: var(--c-text-3); font-size: .8125rem; margin-top: .25rem; }
</style>
