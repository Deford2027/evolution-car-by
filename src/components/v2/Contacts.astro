---
import { contacts } from '../../content/home';
import { site } from '../../content/site';

const mapSrc = 'https://yandex.ru/map-widget/v1/?ll=27.5366%2C53.9134&z=16&pt=27.5366,53.9134,pm2rdm';
---

<section class="section" id="contacts">
  <div class="container">
    <div class="head">
      <div>
        <p class="kicker">{contacts.kicker}</p>
        <h2 class="head__title">{contacts.title}</h2>
      </div>
      <p class="head__lead">{contacts.lead}</p>
    </div>

    <div class="body">
      <div class="info">
        <dl class="rows">
          {contacts.rows.map((row) => (
            <div class="row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>

        <div class="links">
          <a href={site.phoneHref}>{site.phone}</a>
          <a href={site.telegram}>Telegram</a>
          <a href={site.whatsapp}>WhatsApp</a>
        </div>

        <ul class="shots">
          {contacts.photos.map((photo) => (
            <li><img src={photo} alt="" loading="lazy" width="432" height="450" /></li>
          ))}
        </ul>
      </div>

      <div class="map">
        <iframe src={mapSrc} title="Карта: Evolution Car, проспект Машерова, 15/4" loading="lazy" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .head__title { margin-top: .875rem; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 42ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  .body { display: grid; gap: var(--gap); }
  @media (min-width: 1024px) { .body { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 3rem; } }

  .info { display: grid; align-content: start; gap: 1.75rem; }
  .rows { display: grid; gap: 0; border-top: 1px solid var(--c-line); }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .5rem 1.5rem;
    padding-block: .9375rem;
    border-bottom: 1px solid var(--c-line);
  }
  .row dt { color: var(--c-text-3); font-size: .875rem; }
  .row dd { font-size: .9375rem; text-align: right; }

  .links { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: .9375rem; }
  .links a { color: var(--c-accent); }
  .links a:hover { color: var(--c-accent-hover); }

  .shots { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .375rem; }
  .shots img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-card); }

  .map { border-radius: var(--r-card); overflow: hidden; min-height: 22rem; }
  .map iframe { width: 100%; height: 100%; min-height: 22rem; border: 0; filter: grayscale(.4) brightness(.78); }
</style>
