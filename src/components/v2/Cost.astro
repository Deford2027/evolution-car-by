---
import { calc } from '../../content/home';
import { site } from '../../content/site';
---

<section class="cost" id="cost">
  <img class="cost__bg" src="/img/IMG_4961_1.png" alt="" loading="lazy" width="932" height="1243" />
  <div class="container cost__inner">
    <div class="cost__copy">
      <p class="kicker">{calc.kicker}</p>
      <h2 class="cost__title">{calc.title}</h2>
      <p class="cost__lead">{calc.lead}</p>
      <p class="cost__note">{calc.note}</p>
    </div>

    <aside class="panel">
      <p class="panel__title">Личный расчёт под ключ</p>
      <p class="panel__text">
        Четыре вопроса об автомобиле – и менеджер подготовит предварительную стоимость
        с учётом доставки, таможенного оформления и подготовки документов.
      </p>
      <button class="btn btn--block" type="button" data-open="quiz">{calc.cta}</button>

      <div class="manager">
        <img src="/img/IMG_7468_1.png" alt="" loading="lazy" width="840" height="970" />
        <div>
          <p class="manager__name">{calc.manager.name}</p>
          <p class="manager__role">{calc.manager.role}</p>
        </div>
      </div>

      <div class="panel__links">
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={site.telegram}>Telegram</a>
        <a href={site.whatsapp}>WhatsApp</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .cost {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .cost__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    z-index: -2;
  }
  .cost::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(22, 25, 27, .94) 0%, rgba(22, 25, 27, .72) 55%, rgba(22, 25, 27, .55) 100%);
  }
  .cost__inner {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 1.6rem + 5.6vw, 5.5rem);
    align-items: center;
  }
  .cost__title { margin-top: .875rem; max-width: 20ch; }
  .cost__lead { color: var(--c-text-2); margin-top: 1.25rem; max-width: 48ch; font-size: .9375rem; }
  .cost__note { color: var(--c-text-3); margin-top: 1rem; font-size: .8125rem; }

  /* тёплая подложка формы – приём эталона: панель не прозрачная, а на своём фоне */
  .panel {
    background: color-mix(in srgb, #3a241c 82%, var(--c-surface));
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 1rem + 2vw, 2rem);
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .panel__title { font-family: var(--font-display); font-size: 1.25rem; }
  .panel__text { color: var(--c-text-2); font-size: .875rem; line-height: 1.5; }

  .manager {
    display: flex;
    align-items: center;
    gap: .875rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-line);
  }
  .manager img {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
  }
  .manager__name { font-weight: 600; }
  .manager__role { color: var(--c-text-3); font-size: .8125rem; }

  .panel__links { display: flex; flex-wrap: wrap; gap: 1rem; font-size: .875rem; }
  .panel__links a { color: var(--c-accent); }
  .panel__links a:hover { color: var(--c-accent-hover); }

  @media (min-width: 1024px) {
    .cost__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 25rem); gap: 4rem; }
  }
</style>
