---
import { hero, benefits } from '../../content/home';
import { site } from '../../content/site';
---

<section class="hero">
  <img class="hero__bg" src="/img/hero-evolution-hd-v2.jpg" alt="" fetchpriority="high" width="1448" height="1086" />
  <div class="container hero__inner">
    <h1 class="hero__title">{hero.title}</h1>
    <p class="hero__lead">
      {hero.lead}. Шоурум и сервис в Минске: {site.showroom}.
    </p>
    <div class="hero__actions">
      <a class="btn" href="#final">{hero.cta}</a>
      <a class="btn btn--ghost" href="/zeekr/catalog/">Каталог из Китая</a>
      <a class="btn btn--ghost" href="#cost">Рассчитать стоимость</a>
      <a class="btn btn--ghost" href="#service">Сервис</a>
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="container hero__facts">
    {benefits.map((item) => (
      <article class="fact">
        <h2 class="fact__title">{item.title}</h2>
        <p class="fact__text">{item.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(84svh, 46rem);
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(26, 30, 32, .88) 0%, rgba(26, 30, 32, .35) 62%, rgba(26, 30, 32, .1) 100%),
      linear-gradient(0deg, var(--c-bg) 1%, rgba(26, 30, 32, 0) 42%);
  }
  .hero__inner { padding-block: clamp(3rem, 1.5rem + 6vw, 6rem); display: grid; gap: 1.5rem; }
  .hero__title { max-width: 18ch; }
  .hero__lead { color: var(--c-text-2); max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .625rem; margin-top: .75rem; }

  .section--tight { padding-block: clamp(2rem, 1.2rem + 3vw, 3.25rem); }
  .hero__facts { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  /* как у эталона: не карточки, а колонки текста на фоне страницы */
  .fact__title {
    font-size: clamp(1.0625rem, 1rem + .35vw, 1.25rem);
    margin-bottom: .625rem;
  }
  .fact__text { color: var(--c-text-2); font-size: .9375rem; line-height: 1.5; }

  @media (min-width: 640px) { .hero__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .hero__facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
