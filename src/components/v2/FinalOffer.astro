---
import { finalOffer } from '../../content/home';
import LeadForm from '../islands/LeadForm';
---

<section class="final" id="final">
  <img class="final__bg" src="/img/image.png" alt="" loading="lazy" width="1680" height="1120" />
  <div class="container final__inner">
    <div class="final__copy">
      <h2 class="final__title">{finalOffer.title}</h2>
      <p class="final__lead">{finalOffer.lead}</p>
    </div>

    <div class="final__panel">
      <p class="final__panel-title">Заявка на подбор</p>
      <LeadForm
        client:visible
        namePlaceholder={finalOffer.namePlaceholder}
        phonePlaceholder={finalOffer.phonePlaceholder}
        cta={finalOffer.cta}
        consent={finalOffer.consent}
        success={finalOffer.success}
        source="Финальный оффер (V2)"
      />
    </div>
  </div>
</section>

<style>
  .final { position: relative; isolation: isolate; overflow: hidden; }
  .final__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .final::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(22, 25, 27, .92) 0%, rgba(22, 25, 27, .6) 60%, rgba(22, 25, 27, .35) 100%);
  }
  .final__inner {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 1.6rem + 5.6vw, 5.5rem);
    align-items: center;
  }
  .final__title { max-width: 18ch; }
  .final__lead { color: var(--c-text-2); margin-top: 1.25rem; max-width: 48ch; font-size: .9375rem; }

  .final__panel {
    background: color-mix(in srgb, #3a241c 82%, var(--c-surface));
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 1rem + 2vw, 2rem);
    display: grid;
    gap: 1.25rem;
  }
  .final__panel-title { font-family: var(--font-display); font-size: 1.25rem; }

  @media (min-width: 1024px) {
    .final__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: 4rem; }
  }
</style>
