---
import { steps } from '../../content/home';
---

<section class="section" id="steps">
  <div class="container">
    <div class="head">
      <div>
        <p class="kicker">{steps.kicker}</p>
        <h2 class="head__title">{steps.title}</h2>
      </div>
      <a class="btn head__cta" href="#final" data-open="lead">Оставить заявку</a>
    </div>

    <ol class="flow">
      {steps.items.map((step, i) => (
        <li class="step">
          <p class="step__num">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="step__title">{step.title}</h3>
          {step.text.split('\n').map((line) => <p class="step__text">{line}</p>)}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.5rem; margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .head__title { margin-top: .875rem; max-width: 22ch; }
  .head__cta { justify-self: start; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 3rem; }
    .head__cta { justify-self: end; }
  }

  /* лента 01–05: приём из Figma-концепта вместо карусели карточек */
  .flow {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--c-line);
  }
  .step {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--c-line);
    display: grid;
    gap: .5rem;
    align-content: start;
  }
  .step__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--c-accent);
    letter-spacing: .02em;
  }
  .step__title { font-size: clamp(1.0625rem, 1rem + .4vw, 1.1875rem); line-height: 1.3; }
  .step__text { color: var(--c-text-2); font-size: .875rem; line-height: 1.5; }

  @media (min-width: 768px) {
    .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
    .step:nth-child(odd) { border-left: 0; padding-left: 0; margin-left: 0; }
  }
  @media (min-width: 1100px) {
    .flow { grid-template-columns: repeat(5, minmax(0, 1fr)); border-bottom: 1px solid var(--c-line); }
    .step:nth-child(odd) { border-left: 1px solid var(--c-line); padding-left: 1.5rem; margin-left: -.75rem; }
    .step:first-child { border-left: 0; padding-left: 0; margin-left: 0; }
    .step { border-bottom: 0; padding-block: 1.75rem; }
    .step + .step { border-left: 1px solid var(--c-line); padding-left: 1.5rem; margin-left: -.75rem; }
  }
</style>
