---
import { directions } from '../../content/home';
---

<section class="section" id="directions">
  <div class="container">
    <div class="head">
      <div>
        <p class="kicker">{directions.kicker}</p>
        <h2 class="head__title">{directions.title}</h2>
      </div>
      <p class="head__lead">{directions.lead}</p>
    </div>

    <ul class="dirs">
      {directions.items.map((item) => (
        <li class="dir">
          <div class="dir__body">
            <h3 class="dir__title">{item.title}</h3>
            <p class="dir__text">{item.text}</p>
          </div>
          <div class="dir__shot">
            <img src={item.img} alt="" loading="lazy" width="854" height="950" />
            <span class="badge"><i aria-hidden="true"></i>Под заказ</span>
          </div>
          <a class="btn dir__cta" href="/zeekr/catalog/">{item.cta}</a>
        </li>
      ))}
    </ul>

    <div class="fallback">
      <div>
        <h3 class="fallback__title">{directions.fallback.title}</h3>
        <p class="fallback__text">{directions.fallback.text}</p>
      </div>
      <a class="btn" href="#final" data-open="lead">{directions.fallback.cta}</a>
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .head__title { margin-top: .875rem; max-width: 22ch; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 42ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  .dirs { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .dirs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .dirs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* Как у эталона на Tilda: крупный заголовок и текст, под ними картинка,
     кнопка – под картинкой и никогда на неё не заходит. */
  .dir {
    background: var(--c-surface);
    border-radius: var(--r-card);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .dir__body { padding: 1.5rem 1.25rem 1.25rem; display: grid; gap: .75rem; align-content: start; }
  .dir__title { font-size: clamp(1.5rem, 1.2rem + 1.1vw, 1.875rem); line-height: 1.15; }
  .dir__text { color: var(--c-text-2); font-size: .9375rem; line-height: 1.5; }
  .dir__shot { position: relative; align-self: end; }
  /* исходники вертикальные: кадрируем по нижней трети, где стоит автомобиль */
  .dir__shot img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: center 72%; }
  .badge {
    position: absolute;
    top: .75rem;
    left: .75rem;
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    padding: .3125rem .625rem;
    border-radius: var(--r-btn);
    background: var(--c-ok-soft);
    backdrop-filter: blur(6px);
    color: var(--c-text);
    font-size: .75rem;
  }
  .badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-ok); }
  .dir__cta { margin: 1.25rem; justify-content: center; text-align: center; }
  /* в ряду карточки делят общие строки: картинки и кнопки встают в одну линию,
     даже когда тексты разной длины */
  @media (min-width: 640px) {
    .dir { grid-row: span 3; grid-template-rows: subgrid; row-gap: 0; }
  }

  .fallback {
    margin-top: clamp(2rem, 1.2rem + 3vw, 3rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    background: var(--c-surface);
    display: grid;
    gap: 1.5rem;
  }
  .fallback__title { font-size: clamp(1.25rem, 1.1rem + .9vw, 1.75rem); }
  .fallback__text { color: var(--c-text-2); font-size: .9375rem; margin-top: .75rem; max-width: 72ch; }
  @media (min-width: 900px) {
    .fallback { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3rem; }
  }
</style>
