---
import { faq } from '../../content/home';
---

<section class="section" id="faq">
  <div class="container">
    <div class="head">
      <div>
        <p class="kicker">{faq.kicker}</p>
        <h2 class="head__title">{faq.title}</h2>
      </div>
    </div>

    <div class="items">
      {faq.items.map((item, i) => (
        <details class="item" name="faq" open={i === 0}>
          <summary class="q">
            <span>{item.q}</span>
            <span class="q__mark" aria-hidden="true"></span>
          </summary>
          <div class="a">
            {item.a.split('\n').map((line) => <p>{line}</p>)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .head { margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .head__title { margin-top: .875rem; max-width: 24ch; }

  .items { border-top: 1px solid var(--c-line); }
  .item { border-bottom: 1px solid var(--c-line); }
  .q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1rem, .95rem + .35vw, 1.1875rem);
  }
  .q::-webkit-details-marker { display: none; }
  /* плюс из двух линий: закрыт — крест, открыт — минус */
  .q__mark {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .q__mark::before,
  .q__mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: var(--c-text-2);
    transition: transform .25s var(--ease), background .25s var(--ease);
  }
  .q__mark::after { transform: rotate(90deg); }
  .item[open] .q__mark::before,
  .item[open] .q__mark::after { background: var(--c-accent); }
  .item[open] .q__mark::after { transform: rotate(0deg); }

  .a { display: grid; gap: .625rem; padding-bottom: 1.5rem; max-width: 80ch; }
  .a p { color: var(--c-text-2); font-size: .9375rem; line-height: 1.55; }

  @media (min-width: 1024px) {
    .items { columns: 2; column-gap: 3rem; }
    .item { break-inside: avoid; }
  }
</style>
