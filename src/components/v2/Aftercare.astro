---
import { service } from '../../content/home';
---

<section class="section" id="service">
  <div class="container">
    <div class="head">
      <h2 class="head__title">{service.title}</h2>
      <p class="head__lead">{service.lead}</p>
    </div>

    <div class="body">
      <figure class="media">
        <img src="/img/unsplash/service.jpg" alt="" loading="lazy" width="900" height="600" />
        <button class="media__play" type="button" data-open="video" aria-label="Смотреть видео о сервисе">
          <span aria-hidden="true">▶</span>
        </button>
      </figure>

      <div class="list-wrap">
        <ul class="list">
          {service.items.map((item) => <li class="list__item">{item}</li>)}
        </ul>
        <a class="btn service__cta" href="#final" data-open="lead">{service.cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .head__title { max-width: 20ch; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 46ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  .body { display: grid; gap: var(--gap); }
  @media (min-width: 1024px) { .body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; } }

  .media { position: relative; border-radius: var(--r-card); overflow: hidden; }
  .media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .media__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-bg) 55%, transparent);
    border: 1px solid var(--c-line-strong);
    backdrop-filter: blur(8px);
    color: var(--c-text);
    display: grid;
    place-items: center;
    transition: background .25s var(--ease);
  }
  .media__play:hover { background: var(--c-btn-bg); border-color: transparent; }

  .list-wrap { display: grid; align-content: start; gap: 1.75rem; }
  .list { display: grid; border-top: 1px solid var(--c-line); }
  .list__item {
    padding-block: .9375rem;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-text-2);
    font-size: .9375rem;
  }
  @media (min-width: 560px) {
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  }
  .service__cta { justify-self: start; }
</style>
