---
import { salon } from '../../content/home';
---

<section class="section" id="showroom">
  <div class="container">
    <div class="head">
      <h2 class="head__title">{salon.title}</h2>
      <p class="head__lead">{salon.lead}</p>
    </div>

    <ul class="points">
      {salon.cards.map((card) => (
        <li class="point">
          <h3 class="point__title">{card.title}</h3>
          <p class="point__text">{card.text}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; }
  .head__title { max-width: 18ch; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 46ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  /* три преимущества – карточками в рамке, как у эталона на Tilda */
  .points {
    display: grid;
    gap: .75rem;
    margin-top: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
  }
  .point {
    padding: 1.25rem 1.25rem 1.375rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
  }
  .point__title { font-size: clamp(1.125rem, 1rem + .5vw, 1.375rem); margin-bottom: .5rem; }
  .point__text { color: var(--c-text-2); font-size: .9375rem; line-height: 1.5; max-width: 52ch; }

  @media (min-width: 900px) {
    .points { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
    .point { padding: 1.75rem; }
  }

</style>
