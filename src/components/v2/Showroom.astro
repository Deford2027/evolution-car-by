---
import { salon } from '../../content/home';
---

<section class="section" id="showroom">
  <div class="container">
    <div class="head">
      <h2 class="head__title">{salon.title}</h2>
      <p class="head__lead">{salon.lead}</p>
    </div>

    <ul class="points">
      {salon.cards.map((card) => (
        <li class="point">
          <h3 class="point__title">{card.title}</h3>
          <p class="point__text">{card.text}</p>
        </li>
      ))}
    </ul>

    <figure class="stage">
      <img src="/img/image_467.png" alt="" loading="lazy" width="1680" height="617" />
    </figure>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; }
  .head__title { max-width: 18ch; }
  .head__lead { color: var(--c-text-2); font-size: .9375rem; max-width: 46ch; }
  @media (min-width: 1024px) {
    .head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
    .head__lead { justify-self: end; }
  }

  .points {
    display: grid;
    gap: 0;
    margin-top: clamp(2rem, 1.2rem + 3vw, 3rem);
    border-top: 1px solid var(--c-line);
  }
  .point { padding-block: 1.5rem; border-bottom: 1px solid var(--c-line); }
  .point__title { font-size: clamp(1.0625rem, 1rem + .4vw, 1.25rem); margin-bottom: .5rem; }
  .point__text { color: var(--c-text-2); font-size: .9375rem; max-width: 52ch; }

  @media (min-width: 900px) {
    .points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--c-line);
      gap: 2.5rem;
    }
    .point { border-bottom: 0; padding-block: 1.75rem; }
  }

  .stage { margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem); display: grid; place-items: center; }
  .stage img { width: min(100%, 60rem); object-fit: contain; }
</style>
