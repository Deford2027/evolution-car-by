---
import { site, nav, ui } from '../../content/site';
import MobileMenu from '../islands/MobileMenu.tsx';

// на внутренних страницах якоря должны вести на главную V2
const home = '/zeekr/';
const links = nav.map((l) => ({
  ...l,
  href: l.href.startsWith('#') ? home + l.href : l.href.startsWith('/catalog/') ? '/zeekr/catalog/' : l.href,
}));
---

<div class="topbar">
  <div class="container topbar__inner">
    <p>Шоурум: {site.showroom}</p>
    <p class="topbar__group">
      <span class="topbar__label">Отдел продаж</span>
      <a href={site.phoneHref}>{site.phone}</a>
    </p>
    <p class="topbar__group topbar__service">
      <span class="topbar__label">Сервис</span>
      <span>{site.service}</span>
    </p>
    <p class="topbar__group">
      <span class="topbar__label">Режим работы</span>
      <span class="topbar__strong">{site.hoursFull}</span>
    </p>
  </div>
</div>

<header class="hdr">
  <div class="container hdr__inner">
    <a class="hdr__logo" href="/zeekr/" aria-label={site.brand}>
      <img src="/img/EVOLUTION_CARS_.svg" alt="" width="123" height="23" />
    </a>

    <nav class="hdr__nav" aria-label="Основное меню">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="hdr__icons">
      <a class="hdr__icon" href={site.phoneHref} aria-label={`Позвонить: ${site.phone}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      </a>
      <a class="hdr__icon" href={site.telegram} aria-label="Написать в Telegram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.4 4.3 18.2 19.4c-.24 1.07-.87 1.33-1.77.83l-4.88-3.6-2.36 2.27c-.26.26-.48.48-.98.48l.35-4.97 9.05-8.18c.39-.35-.09-.54-.61-.2L5.83 13.08 1.02 11.57c-1.05-.33-1.07-1.05.22-1.55L19.98 2.8c.87-.32 1.63.2 1.42 1.5z"/></svg>
      </a>
    </div>

    <div class="hdr__actions">
      <a class="btn hdr__cta" href="/zeekr/catalog/">Каталог</a>
      <a class="btn btn--ghost hdr__cta" href="#service">Сервис</a>
    </div>

    <MobileMenu client:media="(max-width: 1279px)" links={links} phone={site.phone} phoneHref={site.phoneHref} cta={ui.order} />
  </div>
</header>

<style>
  .topbar {
    background: var(--c-bg-alt);
    border-bottom: 1px solid var(--c-line);
    font-size: .75rem;
    color: var(--c-text-3);
  }
  .topbar__inner {
    display: none;
    align-items: center;
    gap: 2rem;
    min-height: var(--topbar-h);
  }
  .topbar__group { display: flex; align-items: baseline; gap: .5rem; }
  .topbar__label { text-transform: uppercase; letter-spacing: .06em; font-size: .6875rem; }
  .topbar__group a,
  .topbar__strong { color: var(--c-text); font-weight: 600; }
  .topbar__service { margin-left: auto; }

  .hdr {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--c-bg) 72%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-line);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, .3rem + 2.2vw, 2.5rem);
    min-height: var(--header-h);
  }
  .hdr__logo img { height: 1.375rem; width: auto; }

  .hdr__nav { display: none; gap: clamp(.75rem, .2rem + 1.2vw, 1.5rem); }
  .hdr__nav a { color: var(--c-text-2); font-size: .9375rem; white-space: nowrap; transition: color .2s var(--ease); }
  .hdr__nav a:hover { color: var(--c-accent); }

  /* Иконки связи — квадратные кнопки; на телефоне стоят рядом с меню */
  .hdr__icons { display: flex; gap: .5rem; margin-left: auto; }
  .hdr__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--c-line-strong, var(--c-line));
    border-radius: var(--r-btn);
    color: var(--c-text);
    transition: color .2s var(--ease), border-color .2s var(--ease);
  }
  .hdr__icon:hover, .hdr__icon:focus-visible { color: var(--c-accent); border-color: var(--c-accent); }
  /* иконки уже прижаты вправо — меню встаёт сразу за ними, а не делит место пополам */
  .hdr__inner :global(.mm) { margin-left: 0; }
  /* во второй версии полное меню влезает только с 1280 px — до этого нужен бургер,
     а общее правило островов прячет его уже с 1101 px */
  @media (min-width: 1101px) and (max-width: 1279px) { .hdr__inner :global(.mm) { display: block; } }
  .hdr__inner :global(.mm__burger) { transition: border-color .2s var(--ease); }
  .hdr__inner :global(.mm__burger:hover) { border-color: var(--c-accent); }
  .hdr__inner :global(.mm__burger:hover .mm__bars i) { background: var(--c-accent); }

  .hdr__actions { display: none; gap: .625rem; }
  .hdr__cta { white-space: nowrap; }

  @media (min-width: 1280px) {
    .topbar__inner { display: flex; }
    .hdr__nav { display: flex; }
    .hdr__actions { display: flex; }
  }
</style>
