---
import { salon } from '../../content/home';
---

<section class="section showroom" id="showroom">
  <div class="container showroom__grid">
    <div class="showroom__head">
      <h2>{salon.title}</h2>
      <p class="showroom__lead">{salon.lead}</p>
      <a class="btn btn--ghost showroom__cta" href="/catalog/">Смотреть каталог →</a>
    </div>

    <ol class="showroom__list">
      {salon.cards.map((card, i) => (
        <li class="showroom__item">
          <span class="showroom__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="showroom__item-title">{card.title}</h3>
          <p class="showroom__item-text">{card.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Заголовок слева, преимущества справа нумерованным списком через линии –
     без карточек, которые раньше стояли лесенкой. */
  .showroom__grid { display: grid; gap: clamp(2rem, 1rem + 3vw, 3.5rem); }
  .showroom__head { display: grid; gap: 1.5rem; align-content: start; justify-items: start; }
  .showroom__lead { color: var(--c-text-2); font-size: 1rem; line-height: 1.55; max-width: 46ch; }

  .showroom__list { border-top: 1px solid var(--c-line-strong); }
  .showroom__item {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: .625rem;
    padding-block: clamp(1.5rem, 1rem + 1.2vw, 2rem);
    border-bottom: 1px solid var(--c-line-strong);
  }
  .showroom__num {
    grid-row: span 2;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    line-height: 1;
    color: var(--c-text-3);
    transition: color .25s var(--ease);
  }
  .showroom__item-title { font-size: clamp(1.125rem, 1rem + .6vw, 1.375rem); transition: color .25s var(--ease); }
  .showroom__item-text { color: var(--c-text-3); font-size: .9375rem; line-height: 1.5; max-width: 52ch; }
  /* первый пункт выделен фирменным цветом, остальные загораются при наведении */
  .showroom__item:first-child :is(.showroom__num, .showroom__item-title) { color: var(--c-accent); }
  @media (hover: hover) {
    .showroom__item:hover :is(.showroom__num, .showroom__item-title) { color: var(--c-accent); }
  }

  @media (min-width: 640px) {
    .showroom__item { grid-template-columns: 4.5rem minmax(0, 1fr); column-gap: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .showroom__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 5rem; }
  }
</style>
