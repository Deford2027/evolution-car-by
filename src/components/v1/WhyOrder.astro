---
import { why } from '../../content/home';
---

<section class="section why" id="why">
  <div class="container">
    <div class="sec-head">
      <p class="kicker">[ {why.kicker} ]</p>
      <h2 class="why__title">{why.title}</h2>
    </div>

    <ul class="grid grid--3 why__list">
      {why.items.map((item) => (
        <li class="why__card">
          <img class="why__img" src={item.img} alt="" loading="lazy" width="860" height="1000" />
          <div class="why__copy">
            <h3 class="why__card-title">{item.title}</h3>
            <p class="why__card-text">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sec-head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1rem + 3vw, 3rem); }
  @media (min-width: 1024px) {
    .sec-head { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 2rem; align-items: start; }
  }
  .why__title { max-width: 30ch; }

  .why__card {
    position: relative;
    display: grid;
    align-content: end;
    min-height: min(110vw, 31rem);
    padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    border-radius: var(--r-card);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--c-line);
  }
  .why__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .why__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 4, 12, .1) 30%, rgba(0, 4, 12, .72) 72%, rgba(0, 4, 12, .92) 100%);
  }
  .why__copy { display: grid; gap: .625rem; }
  .why__card-title { font-size: clamp(1.125rem, 1rem + .65vw, 1.5rem); }
  .why__card-text { color: var(--c-text-2); font-size: .9375rem; line-height: 1.45; max-width: 34ch; }
</style>
