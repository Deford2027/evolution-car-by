---
import { faq } from '../../content/home';

// на тильде вопросы разложены в две колонки по порядку: 1,2,3 слева, 4,5,6 справа
const half = Math.ceil(faq.items.length / 2);
const columns = [faq.items.slice(0, half), faq.items.slice(half)];
---

<section class="section faq" id="faq">
  <div class="container">
    <div class="sec-head">
      <p class="kicker">[ {faq.kicker} ]</p>
      <h2 class="faq__title">{faq.title}</h2>
    </div>

    <div class="faq__cols">
      {columns.map((column, ci) => (
        <div class="faq__col">
          {column.map((item, ii) => (
            <details class="faq__item" name="faq" open={ci === 0 && ii === 0}>
              <summary class="faq__q">
                <span>{item.q}</span>
                <span class="faq__mark" aria-hidden="true">↗</span>
              </summary>
              <div class="faq__a">
                {item.a.split('\n').map((line) => <p>{line}</p>)}
              </div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sec-head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1rem + 3vw, 3rem); }
  @media (min-width: 1024px) {
    .sec-head { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 2rem; align-items: start; }
  }
  .faq__title { max-width: 24ch; }

  .faq__cols { display: grid; gap: var(--gap); align-items: start; }
  .faq__col { display: grid; gap: var(--gap); align-content: start; }
  @media (min-width: 900px) {
    .faq__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .faq__item {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }
  .faq__q {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1rem, .95rem + .4vw, 1.25rem);
    line-height: 1.3;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__mark {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--c-line-strong);
    border-radius: 8px;
    color: var(--c-text-2);
    transition: background .25s var(--ease), color .25s var(--ease), rotate .25s var(--ease);
  }
  .faq__item[open] .faq__mark {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #fff;
    rotate: 90deg;
  }
  .faq__a { display: grid; gap: .75rem; margin-top: 1.25rem; padding-right: 3.5rem; }
  .faq__a p { color: var(--c-text-3); font-size: .9375rem; line-height: 1.5; }
</style>

<script>
  // Плавное раскрытие: <details> сам переключается рывком, поэтому клик по
  // вопросу перехватываем и анимируем высоту карточки. В группе открыт
  // только один ответ – соседний закрывается так же плавно.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const timing = { duration: 380, easing: 'cubic-bezier(.16, 1, .3, 1)' };
  // направление идущей анимации: true – раскрывается, false – закрывается
  const running = new WeakMap<HTMLDetailsElement, { anim: Animation; open: boolean }>();

  const closedHeight = (el: HTMLDetailsElement) => {
    const answer = el.querySelector<HTMLElement>('.faq__a');
    if (!answer || !el.open) return el.offsetHeight;
    return el.offsetHeight - answer.offsetHeight - parseFloat(getComputedStyle(answer).marginTop);
  };

  const animate = (el: HTMLDetailsElement, open: boolean) => {
    const answer = el.querySelector<HTMLElement>('.faq__a');
    const from = el.offsetHeight;
    running.get(el)?.anim.cancel();
    answer?.getAnimations().forEach((a) => a.cancel());
    if (reduced.matches) { el.open = open; return; }
    let to: number;
    if (open) {
      el.open = true;
      el.style.height = 'auto';
      to = el.offsetHeight;
      el.style.height = '';
      answer?.animate([{ opacity: 0, transform: 'translateY(-.5rem)' }, { opacity: 1, transform: 'none' }], { ...timing, delay: 60, fill: 'backwards' });
    } else {
      to = closedHeight(el);
      answer?.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, fill: 'forwards' });
    }
    el.style.overflow = 'hidden';
    const anim = el.animate([{ height: `${from}px` }, { height: `${to}px` }], timing);
    running.set(el, { anim, open });
    anim.onfinish = () => {
      if (!open) {
        el.open = false;
        answer?.getAnimations().forEach((a) => a.cancel());
      }
      el.style.overflow = '';
      running.delete(el);
    };
  };

  const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq__item')];
  for (const el of items) {
    // Эксклюзивность ведём сами: с атрибутом name браузер закрывает соседний
    // ответ мгновенно и обрывает его анимацию. Без скриптов name остаётся.
    el.dataset.group = el.name;
    el.removeAttribute('name');
    el.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      const state = running.get(el);
      const willOpen = state ? !state.open : !el.open;
      if (willOpen) {
        for (const other of items) {
          const otherOpen = running.get(other)?.open ?? other.open;
          if (other !== el && otherOpen && other.dataset.group === el.dataset.group) animate(other, false);
        }
      }
      animate(el, willOpen);
    });
  }
</script>
