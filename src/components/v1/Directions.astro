---
import { directions } from '../../content/home';
---

<section class="section directions" id="directions">
  <div class="container">
    <div class="sec-head">
      <p class="kicker">[ {directions.kicker} ]</p>
      <div class="sec-head__main">
        <h2>{directions.title}</h2>
        <p class="sec-head__lead">{directions.lead}</p>
      </div>
    </div>
  </div>

  <ul class="dir-track" role="list">
    {directions.items.map((item) => (
      <li class="dir-card">
        <div class="dir-card__copy">
          <h3 class="dir-card__title">{item.title}</h3>
          <p class="dir-card__text">{item.text}</p>
        </div>
        <img class="dir-card__img" src={item.img} alt="" loading="lazy" width="854" height="950" />
        <a class="btn dir-card__cta" href="#final">{item.cta}</a>
      </li>
    ))}
  </ul>

  <div class="container">
    <div class="card dir-fallback">
      <div>
        <h3 class="dir-fallback__title">{directions.fallback.title}</h3>
        <p class="dir-fallback__text">{directions.fallback.text}</p>
      </div>
      <a class="btn dir-fallback__cta" href="#final">{directions.fallback.cta}</a>
    </div>
  </div>
</section>

<style>
  .sec-head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem); }
  .sec-head__lead {
    color: var(--c-text-3);
    max-width: 46ch;
    margin-top: 1.5rem;
    font-size: 1rem;
  }
  @media (min-width: 1024px) {
    .sec-head { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 2rem; }
    .sec-head__main { max-width: 56rem; }
  }

  .dir-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 27rem);
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
  }
  .dir-card {
    position: relative;
    scroll-snap-align: start;
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: min(104vw, 29.75rem);
    padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    grid-template-rows: auto 1fr auto;
    border-radius: var(--r-card);
    background: var(--c-bg-alt);
    border: 1px solid var(--c-line);
    overflow: hidden;
    isolation: isolate;
  }
  .dir-card__img {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 62%;
    object-fit: cover;
    z-index: -1;
  }
  .dir-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--c-bg-alt) 22%, rgba(2, 5, 11, .25) 55%, rgba(2, 5, 11, .65) 100%);
  }
  .dir-card__copy { display: grid; gap: .75rem; }
  .dir-card__title { font-size: clamp(1.125rem, 1rem + .6vw, 1.4375rem); }
  .dir-card__text { color: var(--c-text-2); font-size: .875rem; line-height: 1.45; }
  .dir-card__cta {
    align-self: end;
    margin-top: auto;
    width: 100%;
    font-size: .75rem;
  }

  .dir-fallback {
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    display: grid;
    gap: 1.5rem;
    background: var(--c-bg-alt);
  }
  .dir-fallback__title { font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem); }
  .dir-fallback__text { color: var(--c-text-3); margin-top: 1rem; max-width: 70ch; font-size: 1rem; }
  .dir-fallback__cta { justify-self: start; }
  @media (min-width: 1024px) {
    .dir-fallback { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3rem; }
    .dir-fallback__cta { justify-self: end; }
  }
</style>
