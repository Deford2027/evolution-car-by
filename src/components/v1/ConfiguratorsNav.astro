---
// Блок «другие конфигураторы» в конце страницы конфигуратора.
// current – путь текущей страницы, он из списка исключается.
import { configurators } from '../../content/configurators';

interface Props { current: string }
const { current } = Astro.props;
const rest = configurators.filter((c) => c.href !== current);
---

<section class="cfg-nav">
  <div class="container">
    <h2 class="cfg-nav__title">Другие конфигураторы</h2>
    <ul class="cfg-nav__list">
      {rest.map((c) => (
        <li>
          <a class="cfg-nav__item" href={c.href}>
            <img src={c.cover} alt={`${c.brand} ${c.model}`} width="400" height="300" loading="lazy" decoding="async" />
            <span class="cfg-nav__brand">{c.brand}</span>
            <span class="cfg-nav__model">{c.model}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="cfg-nav__all" href="/konfiguratory/">Все конфигураторы <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .cfg-nav { padding-block: clamp(1.5rem, 1rem + 2vw, 3rem); border-top: 1px solid var(--c-line); }
  .cfg-nav__title { font-size: clamp(1.1rem, 1rem + .6vw, 1.5rem); text-transform: uppercase; margin-bottom: 1rem; }
  .cfg-nav__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 700px) { .cfg-nav__list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; } }
  @media (min-width: 1100px) { .cfg-nav__list { grid-template-columns: repeat(7, minmax(0, 1fr)); } }
  .cfg-nav__item {
    display: grid; gap: .25rem; color: inherit;
    background: var(--c-surface); border-radius: var(--radius); overflow: hidden;
    border: 1px solid transparent; transition: border-color .2s ease;
    padding-bottom: .625rem;
  }
  .cfg-nav__item:hover { border-color: var(--c-accent); }
  .cfg-nav__item img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; margin-bottom: .375rem; }
  .cfg-nav__brand { padding-inline: .625rem; color: var(--c-accent); font-size: .6875rem; letter-spacing: .08em; text-transform: uppercase; }
  .cfg-nav__model { padding-inline: .625rem; font-size: .875rem; line-height: 1.3; }
  .cfg-nav__all { display: inline-block; margin-top: 1rem; color: var(--c-accent); font-weight: 600; font-size: .9375rem; }
</style>
