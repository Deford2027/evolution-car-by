---
import { calc, quiz, finalOffer } from '../../content/home';
import { site } from '../../content/site';
import Quiz from '../islands/Quiz';
---

<section class="section cost" id="cost">
  <div class="container">
    <!-- Плашка-подложка: слева текст и менеджер, справа опрос открыт сразу,
         без всплывающего окна. -->
    <div class="cost__panel">
      <div class="cost__copy">
        <p class="kicker cost__kicker">[ {calc.kicker} ]</p>
        <h2 class="cost__title">{calc.title}</h2>
        <p class="cost__lead">{calc.lead}</p>

        <div class="cost__manager">
          <img class="cost__avatar" src={calc.manager.img} alt={calc.manager.name} loading="lazy" width="240" height="240" />
          <div class="cost__who">
            <p class="cost__name">{calc.manager.name}</p>
            <p class="cost__role">{calc.manager.role} · подготовит расчёт</p>
          </div>
          <a class="cost__chip cost__chip--tg" href={site.telegram} target="_blank" rel="noopener" aria-label="Написать в Telegram"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.4 4.3 18.2 19.4c-.24 1.07-.87 1.33-1.77.83l-4.88-3.6-2.36 2.27c-.26.26-.48.48-.98.48l.35-4.97 9.05-8.18c.39-.35-.09-.54-.61-.2L5.83 13.08 1.02 11.57c-1.05-.33-1.07-1.05.22-1.55L19.98 2.8c.87-.32 1.63.2 1.42 1.5z"/></svg></a>
        </div>
      </div>

      <div class="cost__form">
        <Quiz
          client:visible
          title={quiz.title}
          steps={quiz.steps}
          contactQuestion={quiz.contactStep.q}
          channels={quiz.contactStep.channels}
          success={finalOffer.success}
        />
        <p class="cost__note">{calc.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cost__panel {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 1rem + 2.5vw, 3.5rem);
    padding: clamp(1.25rem, .75rem + 2.5vw, 3.5rem);
    border-radius: calc(var(--r-card) + 8px);
    border: 1px solid var(--c-line-strong);
    background: radial-gradient(90% 120% at 100% 100%, #2a1206 0%, var(--c-surface) 60%);
    overflow: hidden;
    isolation: isolate;
  }
  /* оранжевое свечение из-под формы */
  .cost__panel::before {
    content: '';
    position: absolute;
    right: -10%;
    bottom: -40%;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 81, 2, .4), transparent 65%);
    filter: blur(30px);
    z-index: -1;
    pointer-events: none;
  }

  .cost__copy { display: grid; gap: 1.25rem; align-content: center; }
  .cost__kicker { color: var(--c-accent); }
  .cost__title { max-width: 18ch; font-size: clamp(1.75rem, 1rem + 2.9vw, 3rem); }
  .cost__lead { color: var(--c-text-2); font-size: 1rem; line-height: 1.55; max-width: 46ch; }

  .cost__manager {
    display: flex;
    align-items: center;
    gap: .875rem;
    margin-top: .75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
  }
  .cost__avatar {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    background: #e9e9e6;
  }
  .cost__who { flex: 1; min-width: 0; }
  .cost__name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 1.2; }
  .cost__role { color: var(--c-text-3); font-size: .8125rem; }
  .cost__chip {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .cost__chip:hover { filter: brightness(1.08); }
  .cost__chip--tg { background: #27a7e7; }
  .cost__chip--wa { background: #2cb742; }

  /* Белая карточка опроса. Цвета квиза переопределены переменными,
     поэтому общие стили формы из islands.css работают и на светлом. */
  .cost__form {
    --c-text: var(--c-text-on-light);
    --c-text-2: #4a4a47;
    --c-text-3: #8a8a86;
    --c-line: #e6e6e3;
    --c-line-strong: #dededa;
    --c-surface-2: #f5f5f3;
    --c-accent-soft: #fff1ea;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.25rem, .9rem + 1.5vw, 2.25rem);
    border-radius: var(--r-card);
    background: var(--c-surface-light);
    color: var(--c-text);
    box-shadow: 0 40px 80px -40px rgba(255, 81, 2, .55);
  }
  .cost__form :global(.quiz__title) { font-size: clamp(1.125rem, 1rem + .5vw, 1.375rem); }
  .cost__form :global(.quiz__bar) { height: 4px; border-radius: 4px; }
  .cost__form :global(.quiz__q) { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.25rem, 1.05rem + .8vw, 1.625rem); line-height: 1.15; }
  .cost__form :global(.quiz__option) { background: #fafaf8; border-radius: 14px; padding: 1rem 1.125rem; }
  .cost__form :global(.quiz__option:hover) { background: var(--c-accent-soft); }
  .cost__note { color: var(--c-text-3); font-size: .8125rem; line-height: 1.35; }

  @media (min-width: 560px) {
    .cost__form :global(.quiz__options) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .cost__panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  }
</style>
