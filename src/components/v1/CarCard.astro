---
import type { Car } from '../../content/cars';
import { countries, availabilities, formatUsd, highlights, powertrains, carPath } from '../../content/cars';
import { productItem } from '../../lib/product';

interface Props { car: Car; eager?: boolean }
const { car, eager = false } = Astro.props;

const href = carPath(car);
const inStock = car.availability === 'in-stock';
const specs = highlights(car);
---

<article class="card" data-item={JSON.stringify(productItem(car))}>
  <a class="card__shot" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={car.photo}
      alt=""
      width="600"
      height="375"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <span class={inStock ? 'badge badge--ok' : 'badge'}>
      <i aria-hidden="true"></i>{availabilities[car.availability]}
    </span>
  </a>

  <div class="card__body">
    <p class="card__meta">
      {countries[car.country].label} · {powertrains[car.powertrain]}{car.year ? ` · ${car.year}` : ''}
    </p>
    <h3 class="card__title"><a href={href}>{car.title}</a></h3>
    <p class="card__tagline">{car.description}</p>

    {specs.length > 0 && (
      <ul class="card__specs">
        {specs.map((item) => <li>{item}</li>)}
      </ul>
    )}

    {car.priceUsd && (
      <p class="card__price">
        от {formatUsd(car.priceUsd)}
        {car.priceByn && <span class="card__price-byn">≈ {car.priceByn.toLocaleString('ru-RU')} BYN</span>}
      </p>
    )}
    <span class="btn btn--block card__cta">Подробнее</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    transition: border-color .25s var(--ease);
  }
  .card:hover { border-color: var(--c-line-strong); }

  .card__shot { position: relative; display: block; background: var(--c-bg-alt); }
  .card__shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .badge {
    position: absolute;
    top: .875rem;
    left: .875rem;
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    padding: .375rem .75rem;
    border-radius: var(--r-pill);
    background: rgba(2, 5, 11, .78);
    backdrop-filter: blur(6px);
    font-size: .75rem;
  }
  .badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-text-3); }
  .badge--ok i { background: var(--c-accent); }

  .card__body {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    gap: .625rem;
  }
  .card__meta { color: var(--c-text-3); font-size: .8125rem; }
  .card__title { font-size: clamp(1.125rem, 1rem + .6vw, 1.375rem); line-height: 1.15; }
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card__tagline {
    color: var(--c-text-3);
    font-size: .875rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__specs { display: flex; flex-wrap: wrap; gap: .375rem; align-content: start; margin-top: .25rem; }
  .card__specs li {
    padding: .3125rem .625rem;
    border: 1px solid var(--c-line);
    border-radius: 8px;
    color: var(--c-text-2);
    font-size: .75rem;
  }

  .card__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    margin-top: .875rem;
    padding-top: .875rem;
    border-top: 1px solid var(--c-line);
    display: flex;
    align-items: baseline;
    gap: .625rem;
    flex-wrap: wrap;
  }
  .card__price-byn {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: .8125rem;
    color: var(--c-text-3);
  }
  .card__cta { margin-top: .25rem; padding-block: 1rem; }
</style>
