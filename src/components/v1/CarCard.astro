---
import type { Car } from '../../content/cars';
import { carTitle, formatPrice, countries, availabilities, conditions } from '../../content/cars';

interface Props { car: Car; eager?: boolean; base?: string }
const { car, eager = false, base = '/catalog/' } = Astro.props;

const href = `${base}${car.slug}/`;
const inStock = car.availability === 'in-stock';
---

<article class="card">
  <a class="card__shot" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={car.photos[0]}
      alt=""
      width="854"
      height="534"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <span class={inStock ? 'badge badge--ok' : 'badge'}>
      <i aria-hidden="true"></i>{availabilities[car.availability]}
    </span>
  </a>

  <div class="card__body">
    <p class="card__meta">{countries[car.country].label} · {conditions[car.condition]} · {car.year}</p>
    <h3 class="card__title"><a href={href}>{carTitle(car)}</a></h3>
    <p class="card__tagline">{car.tagline}</p>

    <ul class="card__specs">
      {car.highlights.map((item) => <li>{item}</li>)}
    </ul>

    <p class="card__price">от {formatPrice(car.priceUsd)}</p>
    <span class="btn btn--block card__cta">Подробнее</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    transition: border-color .25s var(--ease);
  }
  .card:hover { border-color: var(--c-line-strong); }

  .card__shot { position: relative; display: block; }
  .card__shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: center 62%; }
  .badge {
    position: absolute;
    top: .875rem;
    left: .875rem;
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    padding: .375rem .75rem;
    border-radius: var(--r-pill);
    background: rgba(2, 5, 11, .72);
    backdrop-filter: blur(6px);
    font-size: .75rem;
  }
  .badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-text-3); }
  .badge--ok i { background: var(--c-accent); }

  .card__body {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    gap: .625rem;
  }
  .card__meta { color: var(--c-text-3); font-size: .8125rem; }
  /* в этой версии название набрано Oswald, как заголовки на тильде */
  .card__title { font-size: clamp(1.125rem, 1rem + .6vw, 1.375rem); line-height: 1.15; }
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card__tagline { color: var(--c-text-3); font-size: .875rem; line-height: 1.45; }

  .card__specs { display: flex; flex-wrap: wrap; gap: .375rem; align-content: start; margin-top: .25rem; }
  .card__specs li {
    padding: .3125rem .625rem;
    border: 1px solid var(--c-line);
    border-radius: 8px;
    color: var(--c-text-2);
    font-size: .75rem;
  }

  .card__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    margin-top: .875rem;
    padding-top: .875rem;
    border-top: 1px solid var(--c-line);
  }
  .card__cta { margin-top: .25rem; padding-block: 1rem; }
</style>
