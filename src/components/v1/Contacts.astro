---
import Socials from '../shared/Socials.astro';
import { contacts } from '../../content/home';
import { site } from '../../content/site';

// Шоурум на Машерова, 15/4. Карта – бесплатный виджет Яндекса, затемнённый
// фильтром; центр карты скрипт сдвигает так, чтобы метка была в свободной части.
const showroom = { lat: 53.9134, lng: 27.5366 };
const routeHref = `https://yandex.ru/maps/?rtext=~${showroom.lat},${showroom.lng}&rtt=auto`;
---

<section class="contacts" id="contacts">
  <div class="contacts__map">
    <iframe
      class="contacts__frame"
      data-map
      data-lat={showroom.lat}
      data-lng={showroom.lng}
      title="Карта: Evolution Car на проспекте Машерова, 15/4"
      loading="lazy"
      allowfullscreen
    ></iframe>
  </div>

  <div class="container contacts__layer">
    <div class="contacts__panel">
      <p class="kicker">[ {contacts.kicker} ]</p>
      <h2 class="contacts__title">{contacts.title}</h2>
      <p class="contacts__lead">{contacts.lead}</p>

      <a class="contacts__phone" href={site.phoneHref}>{site.phone}</a>

      <ul class="contacts__places">
        {contacts.places.map((place) => (
          <li class="contacts__place">
            <p class="contacts__place-label">{place.label}</p>
            <p class="contacts__place-address">{place.address}</p>
            <p class="contacts__place-hours">{place.hours}</p>
          </li>
        ))}
      </ul>

      <ul class="contacts__social">
        <Socials />
      </ul>
      <a class="contacts__route" href={routeHref} target="_blank" rel="noopener">Построить маршрут →</a>
    </div>

    <ul class="contacts__shots">
      {contacts.photos.map((photo) => (
        <li><img src={photo} alt="" loading="lazy" width="432" height="450" /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contacts { position: relative; isolation: isolate; }
  .contacts__map { position: absolute; inset: 0; z-index: -1; }
  .contacts__frame {
    width: 100%;
    height: 100%;
    border: 0;
    background: #1b1d21;
    /* светлая карта Яндекса → тёмно-серая: invert с поворотом оттенка
       сохраняет цвет метки, grayscale убирает пестроту */
    filter: invert(.92) hue-rotate(180deg) grayscale(.55) brightness(.82) contrast(.95);
  }
  /* плавный переход фона страницы в карту сверху и снизу */
  .contacts__map::before,
  .contacts__map::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(5rem, 3rem + 8vw, 10rem);
    z-index: 1;
    pointer-events: none;
  }
  .contacts__map::before { top: 0; background: linear-gradient(180deg, var(--c-bg) 0%, rgba(0, 4, 12, .6) 45%, transparent 100%); }
  .contacts__map::after { bottom: 0; background: linear-gradient(0deg, var(--c-bg) 0%, rgba(0, 4, 12, .6) 45%, transparent 100%); }
  .contacts__route { justify-self: start; margin-top: .25rem; color: var(--c-accent); font-size: .875rem; font-weight: 600; }
  .contacts__route:hover { text-decoration: underline; text-underline-offset: 3px; }

  .contacts__layer {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: end;
    min-height: min(130vw, 40rem);
  }
  /* на телефоне сверху оставляем открытую полосу карты с меткой */
  @media (max-width: 1023px) {
    .contacts__layer { padding-top: 17rem; }
  }

  .contacts__panel {
    background: rgba(2, 5, 11, .78);
    backdrop-filter: blur(10px);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    display: grid;
    gap: 1rem;
    align-content: start;
    max-width: 34rem;
  }
  .contacts__title { font-size: clamp(2rem, 1.2rem + 3.4vw, 3rem); }
  .contacts__lead { color: var(--c-text-2); font-size: .9375rem; }
  .contacts__phone {
    justify-self: start;
    margin-top: .5rem;
    font-weight: 600;
    font-size: clamp(1.25rem, 1.1rem + .5vw, 1.5rem);
    line-height: 1.2;
    color: var(--c-accent);
    transition: color .2s var(--ease);
  }
  .contacts__phone:hover { color: var(--c-accent-hover); }
  .contacts__places { display: grid; border-top: 1px solid var(--c-line); }
  .contacts__place {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .125rem;
    padding-block: .875rem;
    border-bottom: 1px solid var(--c-line);
  }
  .contacts__place-label { color: var(--c-text-3); font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; }
  .contacts__place-address { font-size: 1rem; font-weight: 500; }
  .contacts__place-hours { color: var(--c-text-2); font-size: .875rem; }
  .contacts__social { display: flex; gap: .625rem; margin-top: 1rem; }
  .contacts__social :global(a) {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    border: 1px solid var(--c-line-strong);
    display: grid;
    place-items: center;
    font-size: .6875rem;
    font-weight: 600;
    color: var(--c-text-2);
  }
  .contacts__social :global(a:hover) { background: var(--c-btn2-bg-hover); color: var(--c-text); }

  .contacts__shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 8.75rem;
    gap: .5rem;
    overflow-x: auto;
    scrollbar-width: none;
    justify-self: end;
  }
  .contacts__shots img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }

  @media (min-width: 1024px) {
    .contacts__layer { grid-template-columns: minmax(0, 34rem) minmax(0, 1fr); align-items: end; }
  }
</style>

<script>
  // Виджет сам ставит точку ll в центр окна, а центр закрыт панелью. Поэтому
  // сдвигаем ll на столько пикселей, чтобы метка pt встала в центр свободной
  // части карты (справа от панели на десктопе, над панелью на телефоне).
  const frame = document.querySelector<HTMLIFrameElement>('[data-map]');
  const ZOOM = 16;

  const visibleCenter = (el: HTMLElement) => {
    const box = el.getBoundingClientRect();
    const section = el.closest('.contacts');
    const panel = section?.querySelector<HTMLElement>('.contacts__panel')?.getBoundingClientRect();
    const shots = section?.querySelector<HTMLElement>('.contacts__shots')?.getBoundingClientRect();
    let left = 0, top = 0, right = box.width, bottom = box.height;
    if (panel && panel.right - box.left < box.width * 0.6) {
      left = panel.right - box.left;
      if (shots) bottom = shots.top - box.top;
    } else if (panel) {
      bottom = panel.top - box.top;
    }
    return { dx: (left + right) / 2 - box.width / 2, dy: (top + bottom) / 2 - box.height / 2 };
  };

  const place = () => {
    if (!frame) return;
    const lat = Number(frame.dataset.lat);
    const lng = Number(frame.dataset.lng);
    const { dx, dy } = visibleCenter(frame);
    // веб-меркатор: градусов долготы на пиксель при данном масштабе
    const degPerPx = 360 / (256 * 2 ** ZOOM);
    const centerLng = lng - dx * degPerPx;
    const centerLat = lat + dy * degPerPx * Math.cos((lat * Math.PI) / 180);
    const src = `https://yandex.ru/map-widget/v1/?ll=${centerLng.toFixed(6)}%2C${centerLat.toFixed(6)}&z=${ZOOM}&pt=${lng},${lat},pm2rdm`;
    if (frame.src !== src) frame.src = src;
  };

  if (frame) {
    place();
    let t = 0;
    let lastWidth = innerWidth;
    // на телефоне resize прилетает при прокрутке (адресная строка) – реагируем только на ширину
    addEventListener('resize', () => {
      if (innerWidth === lastWidth) return;
      lastWidth = innerWidth;
      clearTimeout(t);
      t = window.setTimeout(place, 300);
    });
  }
</script>
