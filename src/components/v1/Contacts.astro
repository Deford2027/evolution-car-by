---
// стили карты – в общем CSS страницы: динамический импорт CSS грузится
// по корневому пути и на превью в подпапке отдаёт 404
import 'leaflet/dist/leaflet.css';
import Socials from '../shared/Socials.astro';
import { contacts } from '../../content/home';
import { site } from '../../content/site';

// Шоурум на Машерова, 15/4. Карта – Leaflet с тайлами OpenStreetMap в тёмном
// фильтре: без рекламы и ключа, метка ставится в центр видимой части карты.
const showroom = { lat: 53.9134, lng: 27.5366 };
const routeHref = `https://yandex.ru/maps/?rtext=~${showroom.lat},${showroom.lng}&rtt=auto`;
---

<section class="contacts" id="contacts">
  <div class="contacts__map">
    <div
      class="contacts__leaflet"
      data-map
      data-lat={showroom.lat}
      data-lng={showroom.lng}
      data-ykey={site.yandexMapsKey}
      role="img"
      aria-label="Карта: Evolution Car на проспекте Машерова, 15/4"
    ></div>
  </div>

  <div class="container contacts__layer">
    <div class="contacts__panel">
      <p class="kicker">[ {contacts.kicker} ]</p>
      <h2 class="contacts__title">{contacts.title}</h2>
      <p class="contacts__lead">{contacts.lead}</p>

      <a class="contacts__phone" href={site.phoneHref}>{site.phone}</a>

      <ul class="contacts__places">
        {contacts.places.map((place) => (
          <li class="contacts__place">
            <p class="contacts__place-label">{place.label}</p>
            <p class="contacts__place-address">{place.address}</p>
            <p class="contacts__place-hours">{place.hours}</p>
          </li>
        ))}
      </ul>

      <ul class="contacts__social">
        <Socials />
      </ul>
      <a class="contacts__route" href={routeHref} target="_blank" rel="noopener">Построить маршрут →</a>
    </div>

    <ul class="contacts__shots">
      {contacts.photos.map((photo) => (
        <li><img src={photo} alt="" loading="lazy" width="432" height="450" /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contacts { position: relative; isolation: isolate; }
  .contacts__map { position: absolute; inset: 0; z-index: -1; }
  .contacts__leaflet { width: 100%; height: 100%; background: #1b1d21; }
  /* тёмно-серая карта под цвет сайта: светлые тайлы OSM инвертируются */
  .contacts__leaflet :global(.leaflet-tile-pane) { filter: grayscale(1) invert(1) brightness(.78) contrast(.92); }
  .contacts__leaflet :global(.leaflet-control-attribution) {
    background: rgba(2, 5, 11, .6);
    color: var(--c-text-3);
    font-size: .625rem;
  }
  .contacts__leaflet :global(.leaflet-control-attribution a) { color: var(--c-text-2); }
  .contacts__leaflet :global(.leaflet-control-zoom a) {
    background: rgba(2, 5, 11, .85);
    color: var(--c-text);
    border-color: var(--c-line-strong);
  }
  .contacts__leaflet :global(.ec-pin) {
    display: grid;
    justify-items: center;
    gap: .375rem;
    width: max-content;
    translate: -50% -100%;
  }
  .contacts__leaflet :global(.ec-pin__label) {
    padding: .375rem .75rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: #fff;
    font-weight: 600;
    font-size: .8125rem;
    white-space: nowrap;
    box-shadow: 0 8px 24px -8px rgba(255, 81, 2, .8);
  }
  .contacts__leaflet :global(.ec-pin__dot) {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--c-accent);
    border: 3px solid #fff;
    box-shadow: 0 0 0 8px rgba(255, 81, 2, .25);
  }
  .contacts__route { justify-self: start; margin-top: .25rem; color: var(--c-accent); font-size: .875rem; font-weight: 600; }
  .contacts__route:hover { text-decoration: underline; text-underline-offset: 3px; }

  .contacts__layer {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: end;
    min-height: min(130vw, 40rem);
  }
  /* на телефоне сверху оставляем открытую полосу карты с меткой */
  @media (max-width: 1023px) {
    .contacts__layer { padding-top: 17rem; }
  }

  .contacts__panel {
    background: rgba(2, 5, 11, .78);
    backdrop-filter: blur(10px);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    display: grid;
    gap: 1rem;
    align-content: start;
    max-width: 34rem;
  }
  .contacts__title { font-size: clamp(2rem, 1.2rem + 3.4vw, 3rem); }
  .contacts__lead { color: var(--c-text-2); font-size: .9375rem; }
  .contacts__phone {
    justify-self: start;
    margin-top: .5rem;
    font-weight: 600;
    font-size: clamp(1.25rem, 1.1rem + .5vw, 1.5rem);
    line-height: 1.2;
    color: var(--c-accent);
    transition: color .2s var(--ease);
  }
  .contacts__phone:hover { color: var(--c-accent-hover); }
  .contacts__places { display: grid; border-top: 1px solid var(--c-line); }
  .contacts__place {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .125rem;
    padding-block: .875rem;
    border-bottom: 1px solid var(--c-line);
  }
  .contacts__place-label { color: var(--c-text-3); font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; }
  .contacts__place-address { font-size: 1rem; font-weight: 500; }
  .contacts__place-hours { color: var(--c-text-2); font-size: .875rem; }
  .contacts__social { display: flex; gap: .625rem; margin-top: 1rem; }
  .contacts__social :global(a) {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    border: 1px solid var(--c-line-strong);
    display: grid;
    place-items: center;
    font-size: .6875rem;
    font-weight: 600;
    color: var(--c-text-2);
  }
  .contacts__social :global(a:hover) { background: var(--c-btn2-bg-hover); color: var(--c-text); }

  .contacts__shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 8.75rem;
    gap: .5rem;
    overflow-x: auto;
    scrollbar-width: none;
    justify-self: end;
  }
  .contacts__shots img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }

  @media (min-width: 1024px) {
    .contacts__layer { grid-template-columns: minmax(0, 34rem) minmax(0, 1fr); align-items: end; }
  }
</style>

<script>
  // Карта грузится, только когда блок подъезжает к экрану. С ключом – Яндекс
  // в тёмной теме, без ключа – OpenStreetMap под тёмным фильтром.
  const el = document.querySelector<HTMLElement>('[data-map]');
  const pinHtml = '<div class="ec-pin"><span class="ec-pin__label">Evolution Car</span><span class="ec-pin__dot"></span></div>';
  const coarse = matchMedia('(pointer: coarse)').matches;

  /** Часть карты, не закрытая панелью и фото, – в пикселях от краёв карты. */
  const visibleArea = (map: HTMLElement) => {
    const box = map.getBoundingClientRect();
    const section = map.closest('.contacts');
    const panel = section?.querySelector<HTMLElement>('.contacts__panel')?.getBoundingClientRect();
    const shots = section?.querySelector<HTMLElement>('.contacts__shots')?.getBoundingClientRect();
    const area = { left: 0, top: 0, right: box.width, bottom: box.height, width: box.width, height: box.height };
    if (panel && panel.right - box.left < box.width * 0.6) {
      // десктоп: панель слева, свободна правая часть над лентой фото
      area.left = panel.right - box.left;
      if (shots) area.bottom = shots.top - box.top;
    } else if (panel) {
      // телефон: панель внизу на всю ширину, свободен верх
      area.bottom = panel.top - box.top;
    }
    return area;
  };

  const onResize = (fn: () => void) => {
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(fn, 150); });
  };

  const loadScript = (src: string) => new Promise<void>((resolve, reject) => {
    const s = document.createElement('script');
    s.src = src;
    s.onload = () => resolve();
    s.onerror = () => reject(new Error(`не загрузился ${src}`));
    document.head.append(s);
  });

  const initYandex = async (key: string, lat: number, lng: number) => {
    await loadScript(`https://api-maps.yandex.ru/v3/?apikey=${encodeURIComponent(key)}&lang=ru_RU`);
    const ymaps3 = (window as any).ymaps3;
    // с неверным ключом ready может не завершиться – не ждём дольше 8 секунд
    await Promise.race([ymaps3.ready, new Promise((_, reject) => setTimeout(() => reject(new Error('таймаут')), 8000))]);
    const { YMap, YMapDefaultSchemeLayer, YMapDefaultFeaturesLayer, YMapMarker } = ymaps3;
    // margin сдвигает «центр» карты в свободную часть – метка встаёт по её центру
    const margin = () => {
      const a = visibleArea(el!);
      return [a.top, a.width - a.right, a.height - a.bottom, a.left];
    };
    const map = new YMap(el, {
      location: { center: [lng, lat], zoom: 16 },
      margin: margin(),
      theme: 'dark',
      // колесо и свайп на телефоне листают страницу, а не карту
      behaviors: coarse ? ['dblClick', 'pinchZoom'] : ['drag', 'dblClick'],
    });
    map.addChild(new YMapDefaultSchemeLayer({}));
    map.addChild(new YMapDefaultFeaturesLayer({}));
    const pin = document.createElement('div');
    pin.innerHTML = pinHtml;
    map.addChild(new YMapMarker({ coordinates: [lng, lat] }, pin));
    onResize(() => map.update({ margin: margin(), location: { center: [lng, lat], zoom: 16 } }));
  };

  const initLeaflet = async (lat: number, lng: number) => {
    const { default: L } = await import('leaflet');
    const point = L.latLng(lat, lng);
    const map = L.map(el!, {
      zoomControl: false,
      scrollWheelZoom: false,
      dragging: !coarse,
      attributionControl: true,
    });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
    }).addTo(map);
    L.control.zoom({ position: 'topright' }).addTo(map);
    map.attributionControl.setPrefix('<a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>');
    L.marker(point, {
      icon: L.divIcon({ className: '', html: pinHtml, iconSize: [0, 0] }),
      keyboard: false,
    }).addTo(map);

    const zoom = 16;
    const place = () => {
      const a = visibleArea(el!);
      const target = L.point((a.left + a.right) / 2, (a.top + a.bottom) / 2);
      const shift = L.point(a.width / 2, a.height / 2).subtract(target);
      map.setView(map.unproject(map.project(point, zoom).add(shift), zoom), zoom, { animate: false });
    };
    place();
    onResize(place);
  };

  const init = async () => {
    if (!el) return;
    const lat = Number(el.dataset.lat);
    const lng = Number(el.dataset.lng);
    const key = el.dataset.ykey;
    if (key) {
      try { return await initYandex(key, lat, lng); }
      catch (e) { console.warn('Яндекс Карты недоступны, показываем OpenStreetMap', e); el.innerHTML = ''; }
    }
    await initLeaflet(lat, lng);
  };

  if (el) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); init(); }
    }, { rootMargin: '400px' });
    io.observe(el);
  }
</script>
